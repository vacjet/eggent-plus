index 0000000..c17eb13
--- /dev/null
+++ b/src/app/api/files/versions/review/route.ts
@@ -0,0 +1,64 @@
+import type { NextRequest } from "next/server";
+import { checkTerminalRequest, guardStatus, jsonError } from "@/lib/terminal/guard";
+import { getServerTranslator } from "@/i18n/server";
+import { projectFolderIsLink } from "@/lib/files/workspace-root";
+import { versionsEnabled } from "@/lib/files/versions/config";
+import { editUnderReview, rejectEdit } from "@/lib/files/versions/review";
+
+/**
+ * The edit an agent made to a file, and the person's decision about it.
+ *
+ *   GET  /api/files/versions/review?project=X&paths=a,b   ->  { paths: { a: {current, previous} } }
+ *   POST /api/files/versions/review  { project, path, decision: "reject" | "accept" }
+ *
+ * Reading is one call for the row of files under an answer: asking per file
+ * would be five requests for one line of the screen. "Reject" is a restore of
+ * the version before the agent's, written as a new version (see versions/review);
+ * "accept" writes nothing and answers so the row can stop asking.
+ */
+export async function GET(req: NextRequest) {
+  const failure = await checkTerminalRequest(req, { write: false });
+  if (failure) return jsonError("Not available.", guardStatus(failure));
+  const project = req.nextUrl.searchParams.get("project")?.trim() || "";
+  const paths = (req.nextUrl.searchParams.get("paths") || "")
+    .split(",")
+    .map((value) => value.trim())
+    .filter(Boolean)
+    .slice(0, 25);
+  if (!project || paths.length === 0) return jsonError("project and paths are required", 400);
+  if (!(await versionsEnabled())) return Response.json({ paths: {} }, { headers: { "Cache-Control": "no-store" } });
+  if (await projectFolderIsLink(project)) return jsonError("Not available.", 403);
+
+  const found: Record<string, { current: number; previous: number }> = {};
+  for (const path of paths) {
+    const review = await editUnderReview(project, path).catch(() => null);
+    if (review) found[path] = review;
+  }
+  return Response.json({ paths: found }, { headers: { "Cache-Control": "no-store" } });
+}
+
+export async function POST(req: NextRequest) {
+  const failure = await checkTerminalRequest(req, { write: true });
+  if (failure) return jsonError("Not available.", guardStatus(failure));
+  const t = await getServerTranslator(req.headers.get("accept-language"));
+  const body = (await req.json().catch(() => null)) as { project?: unknown; path?: unknown; decision?: unknown } | null;
+  const project = typeof body?.project === "string" ? body.project.trim() : "";
+  const filePath = typeof body?.path === "string" ? body.path.trim() : "";
+  const decision = body?.decision === "reject" ? "reject" : body?.decision === "accept" ? "accept" : null;
+  if (!project || !filePath || !decision) return jsonError(t("api.error.projectIdAndFilePathRequired"), 400);
+  if (await projectFolderIsLink(project)) return jsonError(t("api.error.invalidFilePath"), 403);
+
+  if (decision === "accept") {
+    return Response.json({ decision, at: new Date().toISOString() }, { headers: { "Cache-Control": "no-store" } });
+  }
+
+  const result = await rejectEdit(project, filePath);
+  if ("refused" in result) {
+    const message = result.refused === "missing" ? t("files.history.versionMissing") : t("files.history.restoreFailed");
+    return Response.json({ error: message, code: result.refused }, { status: 409, headers: { "Cache-Control": "no-store" } });
+  }
+  return Response.json(
+    { decision, restoredFrom: result.restoredFrom, version: result.version },
+    { headers: { "Cache-Control": "no-store" } }
+  );
+}
