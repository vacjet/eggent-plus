diff --git a/src/lib/files/versions/review.ts b/src/lib/files/versions/review.ts
new file mode 100644
index 0000000..3265df6
--- /dev/null
+++ b/src/lib/files/versions/review.ts
@@ -0,0 +1,89 @@
+import fs from "node:fs/promises";
+import { getWorkDir } from "@/lib/storage/project-store";
+import { captureAfter, captureBefore, versionTargetFor, writeFileInside } from "@/lib/files/versions/capture";
+import { versionsEnabled } from "@/lib/files/versions/config";
+import { getVersionStore } from "@/lib/files/versions/store";
+import type { VersionInfo } from "@/lib/files/versions/shape";
+
+/**
+ * The edit an agent made to a file, offered to the person as a decision.
+ *
+ * The history already keeps every version and can put any of them back, so
+ * nothing new is needed to undo an edit. What was missing is the offer: after a
+ * turn that changed a file, the person was told the file exists and left to
+ * discover by themselves that its previous content is one click away.
+ *
+ * "Reject" is a restore of the version before the agent's - written as a new
+ * version of its own, so rejecting can itself be undone. "Accept" writes
+ * nothing: the file already holds what was accepted, and the history is the
+ * record either way.
+ */
+
+export interface EditUnderReview {
+  /** The version the agent's edit left in the file. */
+  current: number;
+  /** The version to bring back to reject it. */
+  previous: number;
+}
+
+/**
+ * Which edit to offer, from the file's versions, newest first.
+ *
+ * Only an agent's newest version is an offer: a person's own save, a restore,
+ * or a change made outside is something they already decided or already know
+ * about. A missing previous version means there is nothing to go back to, and a
+ * deleted one is skipped - bringing a file back to "deleted" is not an edit
+ * being rejected.
+ */
+export function rejectTargetOf(versions: VersionInfo[]): EditUnderReview | null {
+  if (versions.length < 2) return null;
+  const [newest] = versions;
+  if (!newest || newest.by.kind !== "agent") return null;
+  const previous = versions.slice(1).find((version) => !version.deleted);
+  if (!previous) return null;
+  return { current: newest.n, previous: previous.n };
+}
+
+/** Whether this file has an agent edit worth offering, or nothing. */
+export async function editUnderReview(projectId: string, filePath: string): Promise<EditUnderReview | null> {
+  if (!(await versionsEnabled())) return null;
+  const target = await versionTargetFor(projectId, filePath);
+  if (!target) return null;
+  const journal = await getVersionStore().journal(target.key);
+  return rejectTargetOf([...(journal?.versions ?? [])].reverse());
+}
+
+/**
+ * Put back the version before the agent's edit.
+ *
+ * The same writes as restoring by hand, and the same refusal: what the file
+ * holds now is kept first when it can be, and when it cannot (too large to
+ * keep) nothing is written and the caller is told why.
+ */
+export async function rejectEdit(
+  projectId: string,
+  filePath: string
+): Promise<{ restoredFrom: number; version: VersionInfo | null } | { refused: "too-large" | "unreadable" | "missing" | "invalid" }> {
+  if (!(await versionsEnabled())) return { refused: "invalid" };
+  const target = await versionTargetFor(projectId, filePath);
+  if (!target) return { refused: "invalid" };
+
+  const store = getVersionStore();
+  const journal = await store.journal(target.key);
+  const found = rejectTargetOf([...(journal?.versions ?? [])].reverse());
+  if (!found) return { refused: "missing" };
+
+  const content = await store.content(target.key, found.previous);
+  if (!content) return { refused: "missing" };
+
+  const before = await captureBefore(target.absolute).catch(() => "unreadable" as const);
+  if (before === "too-large" || before === "unreadable") return { refused: before };
+
+  try {
+    await writeFileInside(target.absolute, content, await fs.realpath(getWorkDir(projectId)));
+  } catch {
+    return { refused: "invalid" };
+  }
+  const version = await captureAfter(target.absolute, { kind: "restore", restoredFrom: found.previous });
+  return { restoredFrom: found.previous, version };
+}
