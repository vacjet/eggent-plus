index 0000000..f1fc39b
--- /dev/null
+++ b/scripts/test-file-review.ts
@@ -0,0 +1,71 @@
+/**
+ * Checks which agent edit is offered for undo: newest version by the agent, and
+ * the version before it.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-file-review.ts
+ *
+ * The restore itself is the existing one (versions/review.ts), exercised on a
+ * workspace; what is tested here is the choice, which is where a mistake would
+ * mean offering to undo an edit the person made themselves.
+ */
+import assert from "node:assert/strict";
+import { rejectTargetOf } from "../src/lib/files/versions/review.ts";
+import type { VersionAuthorKind, VersionInfo } from "../src/lib/files/versions/shape.ts";
+
+let failed = 0;
+let ran = 0;
+function check(name: string, fn: () => void): void {
+  ran += 1;
+  try {
+    fn();
+    console.log(`  ok    ${name}`);
+  } catch (error) {
+    failed += 1;
+    console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+function version(n: number, kind: VersionAuthorKind, extra: Partial<VersionInfo> = {}): VersionInfo {
+  return { n, at: `2026-11-14T10:0${n}:00.000Z`, size: 10, by: { kind }, ...extra };
+}
+
+// Новее — первым, как их отдаёт история (journal.versions перевёрнут).
+const agentAfterEarlier = [version(3, "agent"), version(2, "person"), version(1, "earlier")];
+
+console.log("какую правку предлагать к отмене:\n");
+
+check("правка агента поверх предыдущей версии", () => {
+  assert.deepEqual(rejectTargetOf(agentAfterEarlier), { current: 3, previous: 2 });
+});
+
+check("одна версия — отменять нечего", () => {
+  assert.equal(rejectTargetOf([version(1, "agent")]), null);
+});
+
+check("новая версия человека — это не правка агента", () => {
+  assert.equal(rejectTargetOf([version(3, "person"), version(2, "agent")]), null);
+});
+
+check("восстановление и правка извне — не то, что предлагается", () => {
+  assert.equal(rejectTargetOf([version(4, "restore"), version(3, "agent")]), null);
+  assert.equal(rejectTargetOf([version(4, "outside"), version(3, "agent")]), null);
+});
+
+check("удалённую версию не возвращаем как отмену правки", () => {
+  const withDeleted = [version(4, "agent"), version(3, "person", { deleted: true }), version(2, "earlier")];
+  assert.deepEqual(rejectTargetOf(withDeleted), { current: 4, previous: 2 });
+});
+
+check("если всё предыдущее удалено — нечего возвращать", () => {
+  const allDeleted = [version(2, "agent"), version(1, "earlier", { deleted: true })];
+  assert.equal(rejectTargetOf(allDeleted), null);
+});
+
+check("пустая история не падает", () => {
+  assert.equal(rejectTargetOf([]), null);
+});
+
+console.log(`\n${ran - failed}/${ran} проверок пройдено`);
+if (failed > 0) process.exit(1);
diff --git a/src/app/api/files/versions/review/route.ts b/src/app/api/files/versions/review/route.ts
