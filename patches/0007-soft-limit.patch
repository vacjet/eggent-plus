+console.log("\nsoft limit:\n");
+
+const usage = (total: number) => ({ turns: 1, input: total, output: 0, cacheRead: 0, cacheWrite: 0, total });
+
+check("zero means no limit at all", () => {
+  assert.equal(exceedsSoftLimit(usage(10_000_000), 0), false);
+  assert.equal(exceedsSoftLimit(usage(10_000_000), undefined), false);
+  assert.equal(exceedsSoftLimit(usage(10_000_000), null), false);
+});
+
+check("the limit is passed, not reached", () => {
+  assert.equal(exceedsSoftLimit(usage(1000), 1000), false, "exactly at the limit is still inside it");
+  assert.equal(exceedsSoftLimit(usage(1001), 1000), true);
+});
+
+check("nonsense limits never warn", () => {
+  assert.equal(exceedsSoftLimit(usage(5), -1), false);
+  assert.equal(exceedsSoftLimit(usage(5), Number.NaN), false);
+});
+
 console.log(`\n${ran} checks, ${failed} failed`);
 process.exit(failed > 0 ? 1 : 0);
