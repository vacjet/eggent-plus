+/**
+ * Whether a chat has gone past the soft limit.
+ *
+ * Zero means "no limit", which is the default: a warning nobody asked for is
+ * noise. The limit warns and never blocks — blocking a spend is billing, and
+ * billing is outside this build (`docs/boundaries.md`).
+ */
+export function exceedsSoftLimit(usage: ChatUsage, softLimitTokens: number | null | undefined): boolean {
+  const limit = Number(softLimitTokens);
+  if (!Number.isFinite(limit) || limit <= 0) return false;
+  return usage.total > limit;
+}
+
 /** Whether there is anything worth showing: one turn with no tokens is not. */
 export function hasChatUsage(usage: ChatUsage): boolean {
   return usage.turns > 0 && usage.total > 0;
