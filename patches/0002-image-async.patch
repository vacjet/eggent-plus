diff --git a/src/lib/pi/image-tasks.ts b/src/lib/pi/image-tasks.ts
new file mode 100644
index 0000000..cbde4fe
--- /dev/null
+++ b/src/lib/pi/image-tasks.ts
@@ -0,0 +1,230 @@
+/**
+ * Async image APIs: the provider answers a generation request with a task, and
+ * the picture arrives later from a second address.
+ *
+ * The OpenAI-compatible shape (`/images/generations` returning base64 inline)
+ * covers most providers, but an aggregator that renders on its own hardware
+ * answers with a task id and asks to be polled. Without this the tool reports
+ * "no inline images" and the person sees nothing, so the task is followed here:
+ * submit, poll, save the bytes.
+ *
+ * Everything is pure apart from the injected fetch and sleep, so the behaviour
+ * is checked in `scripts/test-image-async.ts` without a network.
+ */
+
+/** A generation in flight: which task, and where its result appears. */
+export interface ImageTask {
+  id: string;
+  resultUrl: string;
+}
+
+const ID_FIELDS = ["uid", "id", "task_id", "taskId", "job_id", "jobId"] as const;
+const URL_FIELDS = ["result_url", "resultUrl", "status_url", "statusUrl", "url"] as const;
+const FAILED_STATUSES = new Set(["failed", "error", "cancelled", "canceled", "rejected"]);
+
+/**
+ * The task behind a submit response, or null when the provider answered with
+ * images (or with something that is not a task at all).
+ *
+ * Only called when no image was found in the payload: a provider that returns
+ * `data: []` and a task is exactly the case this exists for, while a provider
+ * that returns `data: [{b64_json}]` and also an `id` is already done.
+ */
+function payloadCarriesImages(record: Record<string, unknown>): boolean {
+  const items = Array.isArray(record.data) ? record.data : Array.isArray(record.images) ? record.images : [];
+  return items.some((item) => {
+    if (!item || typeof item !== "object" || Array.isArray(item)) return false;
+    const entry = item as Record<string, unknown>;
+    return (
+      typeof entry.b64_json === "string" ||
+      typeof entry.image === "string" ||
+      typeof entry.data === "string" ||
+      typeof entry.url === "string"
+    );
+  });
+}
+
+export function imageTaskFromPayload(baseUrl: string, payload: unknown): ImageTask | null {
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) return null;
+  const record = payload as Record<string, unknown>;
+  // A provider that already returned pictures is done: its `id` is a response
+  // id, not a task, and polling it would replace a finished image with a wait.
+  if (payloadCarriesImages(record)) return null;
+  const nested = record.data && typeof record.data === "object" && !Array.isArray(record.data)
+    ? (record.data as Record<string, unknown>)
+    : null;
+  const source = nested ?? record;
+
+  let id = "";
+  for (const field of ID_FIELDS) {
+    const value = source[field] ?? record[field];
+    if (typeof value === "string" && value.trim()) {
+      id = value.trim();
+      break;
+    }
+    if (typeof value === "number") {
+      id = String(value);
+      break;
+    }
+  }
+  if (!id) return null;
+
+  for (const field of URL_FIELDS) {
+    const value = source[field] ?? record[field];
+    if (typeof value === "string" && /^https?:\/\//i.test(value.trim())) {
+      return { id, resultUrl: value.trim() };
+    }
+  }
+  // Nothing in the answer says where the result lives, so use the layout the
+  // async providers in front of us use: a task address under the same base.
+  return { id, resultUrl: `${baseUrl.replace(/\/+$/, "")}/images/tasks/${encodeURIComponent(id)}/result` };
+}
+
+export interface TaskImage {
+  bytes: Uint8Array;
+  mediaType: string;
+}
+
+export interface WaitOptions {
+  /** How many polls before giving up. */
+  attempts?: number;
+  /** Pause between polls. */
+  delayMs?: number;
+  /** Injected for tests. */
+  fetchImpl?: typeof fetch;
+  sleep?: (ms: number) => Promise<void>;
+  /** Injected for tests; a provider that keeps answering "not ready" forever must end. */
+  now?: () => number;
+  /** Wall-clock ceiling for the whole wait. */
+  timeoutMs?: number;
+  onPoll?: (attempt: number, status: string) => void;
+}
+
+export type WaitResult = { ok: true; image: TaskImage } | { ok: false; error: string };
+
+const DEFAULT_ATTEMPTS = 40;
+const DEFAULT_DELAY_MS = 3000;
+const DEFAULT_TIMEOUT_MS = 120_000;
+
+/**
+ * Which image these bytes are, or null when they are not an image at all.
+ *
+ * The bytes decide, not the header: a provider that streams a raw PNG may label
+ * it `application/octet-stream`, and trusting the header would turn a finished
+ * picture into a wait that ends in a timeout.
+ */
+function mediaTypeOf(header: string | null, bytes: Uint8Array): string | null {
+  const fromHeader = (header || "").split(";")[0].trim().toLowerCase();
+  if (bytes.length > 8 && bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47) return "image/png";
+  if (bytes.length > 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return "image/jpeg";
+  if (bytes.length > 12 && bytes[8] === 0x57 && bytes[9] === 0x45 && bytes[10] === 0x42 && bytes[11] === 0x50) return "image/webp";
+  if (bytes.length > 6 && bytes[0] === 0x47 && bytes[1] === 0x49 && bytes[2] === 0x46 && bytes[3] === 0x38) return "image/gif";
+  if (fromHeader.startsWith("image/")) return fromHeader;
+  return null;
+}
+
+function describeJsonFailure(payload: Record<string, unknown>): string | null {
+  const rawStatus = payload.status ?? payload.state;
+  const status = typeof rawStatus === "string" ? rawStatus.trim().toLowerCase() : "";
+  const error = payload.error;
+  const message =
+    typeof error === "string"
+      ? error.trim()
+      : error && typeof error === "object" && !Array.isArray(error)
+        ? String((error as Record<string, unknown>).message || "").trim()
+        : "";
+  if (message) return message;
+  if (FAILED_STATUSES.has(status)) return `Image task ended as ${status}`;
+  return null;
+}
+
+/**
+ * Poll the task until the picture arrives.
+ *
+ * Returns the bytes rather than a path: where a generated file goes is the
+ * caller's business, and a test should not write anything.
+ */
+export async function waitForImageTask(
+  task: ImageTask,
+  token: string,
+  options: WaitOptions = {}
+): Promise<WaitResult> {
+  const attempts = Math.max(1, options.attempts ?? DEFAULT_ATTEMPTS);
+  const delayMs = Math.max(0, options.delayMs ?? DEFAULT_DELAY_MS);
+  const timeoutMs = Math.max(0, options.timeoutMs ?? DEFAULT_TIMEOUT_MS);
+  const doFetch = options.fetchImpl ?? fetch;
+  const sleep = options.sleep ?? ((ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms)));
+  const now = options.now ?? (() => Date.now());
+  const started = now();
+  let last = "no answer yet";
+
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    if (now() - started > timeoutMs) break;
+
+    let response: Response | null = null;
+    let transportError = "";
+    try {
+      response = await doFetch(task.resultUrl, {
+        method: "GET",
+        headers: { Authorization: `Bearer ${token}` },
+      });
+    } catch (error) {
+      transportError = error instanceof Error ? error.message : String(error);
+    }
+
+    if (!response) {
+      last = `the task address did not answer: ${transportError}`;
+    } else {
+      const contentType = (response.headers.get("content-type") || "").toLowerCase();
+      if (response.ok) {
+        const bytes = new Uint8Array(await response.arrayBuffer());
+        const mediaType = bytes.length > 0 ? mediaTypeOf(contentType, bytes) : null;
+        if (mediaType) {
+          return { ok: true, image: { bytes, mediaType } };
+        }
+        if (bytes.length === 0) {
+          // An empty 200 is a provider saying "soon", not a picture.
+          last = "the provider returned an empty image";
+          options.onPoll?.(attempt, last);
+          if (attempt < attempts) await sleep(delayMs);
+          continue;
+        }
+        // Not an image: a status document, or a body we cannot read.
+        const text = bytes.length > 0 ? new TextDecoder().decode(bytes) : "";
+        let payload: Record<string, unknown> | null = null;
+        try {
+          const parsed = text ? JSON.parse(text) : null;
+          payload = parsed && typeof parsed === "object" && !Array.isArray(parsed)
+            ? (parsed as Record<string, unknown>)
+            : null;
+        } catch {
+          payload = null;
+        }
+        const failure = payload ? describeJsonFailure(payload) : null;
+        if (failure) return { ok: false, error: failure };
+        last = payload
+          ? `the provider says the task is ${String(payload.status ?? payload.state ?? "not finished")}`
+          : "the task address answered with neither an image nor a status";
+      } else if (
+        response.status === 202 ||
+        response.status === 404 ||
+        response.status === 409 ||
+        response.status === 425
+      ) {
+        // Accepted, not there yet, or already being worked on: all mean "poll again".
+        last = `the task is not ready (HTTP ${response.status})`;
+      } else {
+        const text = await response.text().catch(() => "");
+        return {
+          ok: false,
+          error: `the task address answered HTTP ${response.status}${text ? `: ${text.slice(0, 300)}` : ""}`,
+        };
+      }
+    }
+
+    options.onPoll?.(attempt, last);
+    if (attempt < attempts) await sleep(delayMs);
+  }
+
+  return { ok: false, error: `the image was still not ready after ${attempts} polls: ${last}` };
+}
