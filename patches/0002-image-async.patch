new file mode 100644
index 0000000..cba3e25
--- /dev/null
+++ b/scripts/test-image-async.ts
@@ -0,0 +1,223 @@
+/**
+ * Checks async image tasks: a provider that answers with a task instead of
+ * pictures, and the wait that turns that task into bytes.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-image-async.ts
+ *
+ * Everything is injected, so this runs in a second and touches no network.
+ */
+import assert from "node:assert/strict";
+import { imageTaskFromPayload, waitForImageTask } from "../src/lib/pi/image-tasks.ts";
+
+let failed = 0;
+let ran = 0;
+function check(name: string, fn: () => void | Promise<void>): Promise<void> {
+  ran += 1;
+  return Promise.resolve()
+    .then(fn)
+    .then(() => console.log(`  ok    ${name}`))
+    .catch((error: unknown) => {
+      failed += 1;
+      console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+    });
+}
+
+const PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 0]);
+
+function imageResponse(): Response {
+  return new Response(PNG, { status: 200, headers: { "content-type": "image/png" } });
+}
+
+function jsonResponse(payload: unknown, status = 200): Response {
+  return new Response(JSON.stringify(payload), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
+}
+
+/** Answers from a queue; the last answer repeats forever. */
+function queuedFetch(answers: Array<() => Response | Promise<Response>>) {
+  const calls: string[] = [];
+  const impl = (async (input: string | URL | Request) => {
+    const url = typeof input === "string" ? input : input instanceof URL ? input.toString() : input.url;
+    calls.push(url);
+    const next = answers.length > 1 ? answers.shift()! : answers[0];
+    return next();
+  }) as typeof fetch;
+  return { impl, calls };
+}
+
+console.log("task detection:\n");
+
+await check("a submit answer with a uid is a task", () => {
+  const task = imageTaskFromPayload("https://api.example.test/v1", { uid: "abc-1" });
+  assert.deepEqual(task, {
+    id: "abc-1",
+    resultUrl: "https://api.example.test/v1/images/tasks/abc-1/result",
+  });
+});
+
+await check("a result address in the answer is used as it is", () => {
+  const task = imageTaskFromPayload("https://api.example.test/v1", {
+    task_id: "t-9",
+    result_url: "https://cdn.example.test/out/t-9.png",
+  });
+  assert.equal(task?.resultUrl, "https://cdn.example.test/out/t-9.png");
+});
+
+await check("a nested id under data is a task too", () => {
+  assert.equal(imageTaskFromPayload("https://x.test", { data: { id: "n-1" } })?.id, "n-1");
+});
+
+await check("an answer with images is not a task", () => {
+  const payload = { created: 1, data: [{ b64_json: "AAAA" }], id: "resp-1" };
+  assert.equal(imageTaskFromPayload("https://x.test", payload), null);
+});
+
+await check("plain text, arrays and null are not tasks", () => {
+  for (const payload of [null, "ok", [], 42, { error: "no" }]) {
+    assert.equal(imageTaskFromPayload("https://x.test", payload), null);
+  }
+});
+
+console.log("\nwaiting:\n");
+
+await check("not ready, then the picture", async () => {
+  const { impl, calls } = queuedFetch([
+    () => jsonResponse({ status: "running" }, 200),
+    () => new Response("", { status: 202 }),
+    () => imageResponse(),
+  ]);
+  const result = await waitForImageTask(
+    { id: "abc", resultUrl: "https://api.example.test/v1/images/tasks/abc/result" },
+    "token",
+    { fetchImpl: impl, sleep: async () => {}, attempts: 5, delayMs: 0 }
+  );
+  assert.equal(result.ok, true);
+  if (result.ok) {
+    assert.equal(result.image.mediaType, "image/png");
+    assert.equal(result.image.bytes.length, PNG.length);
+  }
+  assert.equal(calls.length, 3, "kept polling until the image arrived");
+});
+
+await check("a 404 while the task is being created is not a failure", async () => {
+  const { impl } = queuedFetch([() => new Response("", { status: 404 }), () => imageResponse()]);
+  const result = await waitForImageTask({ id: "a", resultUrl: "https://x.test/r" }, "t", {
+    fetchImpl: impl,
+    sleep: async () => {},
+    attempts: 3,
+    delayMs: 0,
+  });
+  assert.equal(result.ok, true);
+});
+
+await check("a failed task reports the provider's reason", async () => {
+  const { impl } = queuedFetch([() => jsonResponse({ status: "failed", error: { message: "quota" } })]);
+  const result = await waitForImageTask({ id: "a", resultUrl: "https://x.test/r" }, "t", {
+    fetchImpl: impl,
+    sleep: async () => {},
+    attempts: 3,
+    delayMs: 0,
+  });
+  assert.equal(result.ok, false);
+  if (!result.ok) assert.match(result.error, /quota/);
+});
+
+await check("a hard error ends the wait at once", async () => {
+  let polls = 0;
+  const impl = (async () => {
+    polls += 1;
+    return new Response("nope", { status: 500 });
+  }) as typeof fetch;
+  const result = await waitForImageTask({ id: "a", resultUrl: "https://x.test/r" }, "t", {
+    fetchImpl: impl,
+    sleep: async () => {},
+    attempts: 10,
+    delayMs: 0,
+  });
+  assert.equal(result.ok, false);
+  if (!result.ok) assert.match(result.error, /HTTP 500/);
+  assert.equal(polls, 1, "no point polling a broken address ten times");
+});
+
+await check("a task that never finishes ends with a timeout, not a hang", async () => {
+  const { impl, calls } = queuedFetch([() => new Response("", { status: 202 })]);
+  const result = await waitForImageTask({ id: "a", resultUrl: "https://x.test/r" }, "t", {
+    fetchImpl: impl,
+    sleep: async () => {},
+    attempts: 3,
+    delayMs: 0,
+  });
+  assert.equal(result.ok, false);
+  if (!result.ok) assert.match(result.error, /not ready after 3 polls/);
+  assert.equal(calls.length, 3);
+});
+
+await check("the wall clock stops a provider that always says 202", async () => {
+  let clock = 0;
+  const { impl, calls } = queuedFetch([() => new Response("", { status: 202 })]);
+  const result = await waitForImageTask({ id: "a", resultUrl: "https://x.test/r" }, "t", {
+    fetchImpl: impl,
+    sleep: async () => {
+      clock += 60_000;
+    },
+    attempts: 100,
+    delayMs: 1,
+    timeoutMs: 150_000,
+    now: () => clock,
+  });
+  assert.equal(result.ok, false);
+  assert.ok(calls.length <= 4, `stopped by the clock, not by attempts (${calls.length} polls)`);
+});
+
+await check("a PNG labelled octet-stream is still a picture", async () => {
+  const { impl } = queuedFetch([() => new Response(PNG, {
+    status: 200,
+    headers: { "content-type": "application/octet-stream" },
+  })]);
+  const result = await waitForImageTask({ id: "a", resultUrl: "https://x.test/r" }, "t", {
+    fetchImpl: impl,
+    sleep: async () => {},
+    attempts: 2,
+    delayMs: 0,
+  });
+  assert.equal(result.ok, true);
+  if (result.ok) assert.equal(result.image.mediaType, "image/png");
+});
+
+await check("an empty image body is not success", async () => {
+  const { impl } = queuedFetch([() => new Response(new Uint8Array(), {
+    status: 200,
+    headers: { "content-type": "image/png" },
+  })]);
+  const result = await waitForImageTask({ id: "a", resultUrl: "https://x.test/r" }, "t", {
+    fetchImpl: impl,
+    sleep: async () => {},
+    attempts: 2,
+    delayMs: 0,
+  });
+  assert.equal(result.ok, false);
+  if (!result.ok) assert.match(result.error, /empty image/);
+});
+
+await check("a transport error is retried, not fatal", async () => {
+  let attempt = 0;
+  const impl = (async () => {
+    attempt += 1;
+    if (attempt === 1) throw new Error("ECONNRESET");
+    return imageResponse();
+  }) as typeof fetch;
+  const result = await waitForImageTask({ id: "a", resultUrl: "https://x.test/r" }, "t", {
+    fetchImpl: impl,
+    sleep: async () => {},
+    attempts: 3,
+    delayMs: 0,
+  });
+  assert.equal(result.ok, true);
+});
+
+console.log(`\n${ran} checks, ${failed} failed`);
+process.exit(failed > 0 ? 1 : 0);
