+/**
+ * Checks the project total: a sum over the chats a project owns.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-project-usage.ts
+ */
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { readProjectUsage, usageOfChats } from "../src/lib/usage/project-usage.ts";
+
+let failed = 0;
+let ran = 0;
+async function check(name: string, fn: () => Promise<void> | void): Promise<void> {
+  ran += 1;
+  try {
+    await fn();
+    console.log(`  ok    ${name}`);
+  } catch (error) {
+    failed += 1;
+    console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+const msg = (input: number, output: number) => ({ piRuntimeStats: { lastTurn: { input, output } } });
+
+console.log("summing a project:\n");
+
+await check("two chats add up, and both are counted", () => {
+  const usage = usageOfChats([
+    { messages: [msg(100, 50), msg(10, 5)] },
+    { messages: [msg(1, 1)] },
+  ]);
+  assert.equal(usage.chats, 2);
+  assert.equal(usage.turns, 3);
+  assert.equal(usage.total, 167);
+});
+
+await check("a chat with no messages counts as a chat and adds nothing", () => {
+  const usage = usageOfChats([{ messages: [] }, { messages: [msg(5, 5)] }]);
+  assert.equal(usage.chats, 2);
+  assert.equal(usage.total, 10);
+});
+
+await check("messages without stats are skipped", () => {
+  const usage = usageOfChats([{ messages: [{}, { piRuntimeStats: null }, msg(7, 3)] }]);
+  assert.equal(usage.turns, 1);
+  assert.equal(usage.total, 10);
+});
+
+await check("a chat that carries no messages field at all is still a chat", () => {
+  const usage = usageOfChats([{}]);
+  assert.equal(usage.chats, 1);
+  assert.equal(usage.total, 0);
+});
+
+await check("the last named model wins the label", () => {
+  const usage = usageOfChats([
+    { messages: [{ piRuntimeStats: { model: { name: "A" }, lastTurn: { total: 1 } } }] },
+    { messages: [{ piRuntimeStats: { model: { name: "B" }, lastTurn: { total: 1 } } }] },
+  ]);
+  assert.equal(usage.model, "B");
+});
+
+console.log("\nreading from disk:\n");
+
+const dir = await fs.mkdtemp(path.join(os.tmpdir(), "project-usage-"));
+await fs.writeFile(path.join(dir, "c1.json"), JSON.stringify({ id: "c1", projectId: "p1", messages: [msg(100, 100)] }));
+await fs.writeFile(path.join(dir, "c2.json"), JSON.stringify({ id: "c2", projectId: "p1", messages: [msg(1, 1)] }));
+await fs.writeFile(path.join(dir, "c3.json"), JSON.stringify({ id: "c3", projectId: "p2", messages: [msg(999, 999)] }));
+await fs.writeFile(path.join(dir, "broken.json"), "{ not json");
+
+await check("only the project's own chats are summed", async () => {
+  const usage = await readProjectUsage("p1", dir);
+  assert.equal(usage.chats, 2);
+  assert.equal(usage.total, 202);
+});
+
+await check("another project is not mixed in", async () => {
+  const usage = await readProjectUsage("p2", dir);
+  assert.equal(usage.chats, 1);
+  assert.equal(usage.total, 1998);
+});
+
+await check("a broken chat file is skipped, not fatal", async () => {
+  const usage = await readProjectUsage("p1", dir);
+  assert.equal(usage.chats, 2, "the broken file is not counted as a chat");
+});
+
+await check("a missing folder is zero, not an error", async () => {
+  const usage = await readProjectUsage("p1", path.join(dir, "does-not-exist"));
+  assert.deepEqual(usage, { turns: 0, input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0, chats: 0 });
+});
+
+await fs.rm(dir, { recursive: true, force: true });
+
+console.log(`\n${ran} checks, ${failed} failed`);
+process.exit(failed > 0 ? 1 : 0);
