diff --git a/src/lib/usage/project-usage.ts b/src/lib/usage/project-usage.ts
new file mode 100644
index 0000000..9baed66
--- /dev/null
+++ b/src/lib/usage/project-usage.ts
@@ -0,0 +1,68 @@
+import fs from "fs/promises";
+import path from "path";
+import type { Chat } from "@/lib/types";
+import type { PiRuntimeStats } from "@/lib/pi/types";
+import { sumChatUsage, type ChatUsage } from "@/lib/pi/usage-summary";
+
+/**
+ * What a project has spent, summed over the chats that belong to it.
+ *
+ * Each chat already stores the usage of every answer, so a project total is the
+ * same sum as a chat total, done over the chats the project owns. Nothing new is
+ * written: two copies of a spend figure disagree sooner or later, and the copy
+ * that disagrees is always the one somebody is looking at.
+ */
+
+export interface ProjectUsage extends ChatUsage {
+  /** Chats the project owns, whether or not they spent anything. */
+  chats: number;
+}
+
+/** Pure: sum what these chats' messages carry. */
+export function usageOfChats(
+  chats: Array<{ messages?: Array<{ piRuntimeStats?: PiRuntimeStats | null }> }>
+): ProjectUsage {
+  const total: ProjectUsage = { turns: 0, input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0, chats: chats.length };
+  for (const chat of chats) {
+    const messages = (chat.messages ?? []).map((message) => ({ piRuntimeStats: message.piRuntimeStats ?? null }));
+    const usage = sumChatUsage(messages);
+    total.turns += usage.turns;
+    total.input += usage.input;
+    total.output += usage.output;
+    total.cacheRead += usage.cacheRead;
+    total.cacheWrite += usage.cacheWrite;
+    total.total += usage.total;
+    if (usage.model) total.model = usage.model;
+  }
+  return total;
+}
+
+function chatsDir(): string {
+  return path.join(process.cwd(), "data", "chats");
+}
+
+/**
+ * Read the project's chats from disk.
+ *
+ * A chat file that cannot be parsed is skipped rather than failing the figure:
+ * one broken file in a folder should not hide what the rest of the project spent.
+ */
+export async function readProjectUsage(projectId: string, dir = chatsDir()): Promise<ProjectUsage> {
+  let files: string[] = [];
+  try {
+    files = await fs.readdir(dir);
+  } catch {
+    return { turns: 0, input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0, chats: 0 };
+  }
+  const chats: Chat[] = [];
+  for (const file of files) {
+    if (!file.endsWith(".json")) continue;
+    try {
+      const chat = JSON.parse(await fs.readFile(path.join(dir, file), "utf-8")) as Chat;
+      if (chat?.projectId === projectId && Array.isArray(chat.messages)) chats.push(chat);
+    } catch {
+      // A half-written chat is left out of the sum, not turned into an error.
+    }
+  }
+  return usageOfChats(chats);
+}
