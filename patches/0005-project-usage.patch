@@ -0,0 +1,14 @@
+import { NextRequest, NextResponse } from "next/server";
+import { getProject } from "@/lib/storage/project-store";
+import { readProjectUsage } from "@/lib/usage/project-usage";
+
+/** What this project has spent: a sum over its chats' own answers. */
+export async function GET(
+  _req: NextRequest,
+  { params }: { params: Promise<{ id: string }> }
+) {
+  const { id } = await params;
+  const project = await getProject(id);
+  if (!project) return NextResponse.json({ error: "Project not found" }, { status: 404 });
+  return NextResponse.json(await readProjectUsage(id));
+}
