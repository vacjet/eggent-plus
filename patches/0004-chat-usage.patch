diff --git a/src/lib/pi/usage-summary.ts b/src/lib/pi/usage-summary.ts
new file mode 100644
index 0000000..3eb2e61
--- /dev/null
+++ b/src/lib/pi/usage-summary.ts
@@ -0,0 +1,92 @@
+import type { PiRuntimeStats } from "@/lib/pi/types";
+
+/**
+ * What a whole chat has spent, summed from the stats each answer carries.
+ *
+ * Every assistant message already stores `piRuntimeStats` with the usage of its
+ * turn, so the chat total needs no new storage: it is a sum over the messages
+ * that are on disk anyway. That also means the figure survives a restart and
+ * matches exactly what the per-message footer shows.
+ *
+ * A turn with no usage at all (a program on this computer did the work, or the
+ * provider reported nothing) is not a turn that spent tokens, so it is counted
+ * as a turn but adds nothing.
+ */
+
+export interface ChatUsage {
+  /** Answers that carried runtime stats at all. */
+  turns: number;
+  input: number;
+  output: number;
+  cacheRead: number;
+  cacheWrite: number;
+  /** Provider-reported total when present, otherwise the sum of the four counts. */
+  total: number;
+  /** The last model that answered in this chat, for the label next to the figure. */
+  model?: string;
+}
+
+function numberOrZero(value: unknown): number {
+  return typeof value === "number" && Number.isFinite(value) && value > 0 ? value : 0;
+}
+
+export function usageOfTurn(stats: PiRuntimeStats | null | undefined): {
+  input: number;
+  output: number;
+  cacheRead: number;
+  cacheWrite: number;
+  total: number;
+} {
+  const last = stats?.lastTurn;
+  const input = numberOrZero(last?.input);
+  const output = numberOrZero(last?.output);
+  const cacheRead = numberOrZero(last?.cacheRead);
+  const cacheWrite = numberOrZero(last?.cacheWrite);
+  const summed = input + output + cacheRead + cacheWrite;
+  const reported = numberOrZero(last?.total);
+  return { input, output, cacheRead, cacheWrite, total: reported > 0 ? reported : summed };
+}
+
+export function sumChatUsage(items: Array<{ piRuntimeStats?: PiRuntimeStats | null }>): ChatUsage {
+  const usage: ChatUsage = { turns: 0, input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 };
+  for (const item of items) {
+    const stats = item?.piRuntimeStats;
+    if (!stats) continue;
+    usage.turns += 1;
+    const turn = usageOfTurn(stats);
+    usage.input += turn.input;
+    usage.output += turn.output;
+    usage.cacheRead += turn.cacheRead;
+    usage.cacheWrite += turn.cacheWrite;
+    usage.total += turn.total;
+    if (stats.model?.name) usage.model = stats.model.name;
+    else if (stats.model?.id) usage.model = stats.model.id;
+  }
+  return usage;
+}
+
+/**
+ * The same sum over the message stream the chat panel holds.
+ *
+ * Stats travel to the panel as a `data-piStats` part rather than a field, so the
+ * figure shown to the person is computed from what is rendered, not from a
+ * second copy that could drift.
+ */
+export function sumChatUsageFromParts(
+  messages: Array<{ parts: Array<{ type?: string; data?: unknown }> }>
+): ChatUsage {
+  const items: Array<{ piRuntimeStats?: PiRuntimeStats | null }> = [];
+  for (const message of messages) {
+    for (const part of message.parts || []) {
+      if (part?.type === "data-piStats" && part.data && typeof part.data === "object") {
+        items.push({ piRuntimeStats: part.data as PiRuntimeStats });
+      }
+    }
+  }
+  return sumChatUsage(items);
+}
+
+/** Whether there is anything worth showing: one turn with no tokens is not. */
+export function hasChatUsage(usage: ChatUsage): boolean {
+  return usage.turns > 0 && usage.total > 0;
+}
