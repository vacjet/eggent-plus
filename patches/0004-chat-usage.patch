@@ -0,0 +1,90 @@
+/**
+ * Checks the chat total: a sum over the stats each answer already carries.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-usage-summary.ts
+ */
+import assert from "node:assert/strict";
+import { hasChatUsage, sumChatUsage, sumChatUsageFromParts } from "../src/lib/pi/usage-summary.ts";
+
+let failed = 0;
+let ran = 0;
+function check(name: string, fn: () => void): void {
+  ran += 1;
+  try {
+    fn();
+    console.log(`  ok    ${name}`);
+  } catch (error) {
+    failed += 1;
+    console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+const turn = (input: number, output: number, extra: Record<string, number> = {}) => ({
+  piRuntimeStats: { lastTurn: { input, output, ...extra } },
+});
+
+console.log("summing:\n");
+
+check("two answers add up", () => {
+  const usage = sumChatUsage([turn(100, 50), turn(20, 10)]);
+  assert.equal(usage.turns, 2);
+  assert.equal(usage.input, 120);
+  assert.equal(usage.output, 60);
+  assert.equal(usage.total, 180);
+});
+
+check("a provider total wins over the sum of its parts", () => {
+  const usage = sumChatUsage([{ piRuntimeStats: { lastTurn: { input: 10, output: 5, total: 99 } } }]);
+  assert.equal(usage.total, 99, "the provider knows better than we do");
+});
+
+check("cache tokens are counted", () => {
+  const usage = sumChatUsage([turn(10, 5, { cacheRead: 1000, cacheWrite: 200 })]);
+  assert.equal(usage.total, 1215);
+  assert.equal(usage.cacheRead, 1000);
+  assert.equal(usage.cacheWrite, 200);
+});
+
+check("messages without stats and answerless turns add nothing", () => {
+  const usage = sumChatUsage([
+    { piRuntimeStats: null },
+    {},
+    turn(10, 0),
+    { piRuntimeStats: { lastTurn: {} } },
+  ]);
+  assert.equal(usage.turns, 2, "both carrying stats are counted as turns");
+  assert.equal(usage.total, 10, "only the one with tokens contributes");
+});
+
+check("negative and missing numbers are treated as zero", () => {
+  const usage = sumChatUsage([{ piRuntimeStats: { lastTurn: { input: -5, output: 0 } } }]);
+  assert.equal(usage.total, 0);
+});
+
+check("the last named model is kept for the label", () => {
+  const usage = sumChatUsage([
+    { piRuntimeStats: { model: { id: "a", name: "Model A" }, lastTurn: { total: 1 } } },
+    { piRuntimeStats: { model: { id: "b" }, lastTurn: { total: 1 } } },
+  ]);
+  assert.equal(usage.model, "b", "the last one answered most recently");
+});
+
+check("the panel's message parts sum the same way", () => {
+  const usage = sumChatUsageFromParts([
+    { parts: [{ type: "text" }, { type: "data-piStats", data: { lastTurn: { input: 5, output: 5 } } }] },
+    { parts: [{ type: "data-piStats", data: { lastTurn: { input: 1, output: 1 } } }] },
+  ]);
+  assert.equal(usage.turns, 2);
+  assert.equal(usage.total, 12);
+});
+
+check("nothing worth showing when the total is zero", () => {
+  assert.equal(hasChatUsage({ turns: 1, input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 }), false);
+  assert.equal(hasChatUsage({ turns: 0, input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 }), false);
+  assert.equal(hasChatUsage({ turns: 1, input: 5, output: 0, cacheRead: 0, cacheWrite: 0, total: 5 }), true);
+});
+
+console.log(`\n${ran} checks, ${failed} failed`);
+process.exit(failed > 0 ? 1 : 0);
