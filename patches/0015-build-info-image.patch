diff --git a/Dockerfile b/Dockerfile
index e1f9892..ab848df 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -181,6 +181,23 @@ RUN mkdir -p /app/data/tmp /app/data/models/whisper /app/data/ms-playwright /app
   && chmod +x /app/scripts/docker-entrypoint.sh /app/scripts/ensure-pi-packages.mjs /app/scripts/bin/eggent-history /app/scripts/bin/eggent-browser \
   && chown -R node:node /app/data "${PYTHON_VENV}"
 
+# Which build this image is, written inside the image.
+#
+# The settings page shows the build that answers, and the file that says so used
+# to live only in data/ - written by the deployment script. A data volume
+# outlives the image beside it, so a container started by hand or an image
+# rolled back reported the build that used to run there. The image's own copy
+# cannot drift: it is written from build arguments and replaced with the code
+# (src/lib/build-info.ts prefers it over data/).
+ARG EGGENT_UPSTREAM_TAG=""
+ARG EGGENT_PATCH_COUNT=0
+ARG EGGENT_SOURCE_COMMIT=""
+ARG EGGENT_BUILT_AT=""
+RUN printf '{"upstream":"%s","patches":%s,"commit":"%s","builtAt":"%s"}\n' \
+      "$EGGENT_UPSTREAM_TAG" "$EGGENT_PATCH_COUNT" "$EGGENT_SOURCE_COMMIT" "$EGGENT_BUILT_AT" \
+      > /app/build-info.json \
+  && chown node:node /app/build-info.json
+
 USER node
 EXPOSE 3000
 
