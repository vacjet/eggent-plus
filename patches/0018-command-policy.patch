+    onData(Buffer.from(`${said}\n`));
+    return { exitCode: 126 };
+  }
+  return null;
+}
+
 function createInteractiveBashOperations(options: InteractiveBashToolOptions): BashOperations {
   return {
     exec: async (command, cwd, execOptions) => {
