+    kind: "confirm",
+    title: t("commandPolicy.ask.title"),
+    message: t("commandPolicy.ask.message", { reason: verdict.reason ?? "", command }),
+    // A card that waits for ever holds the turn: a run nobody is watching (a
+    // script, a messenger, a client that never draws the card) would sit here
+    // until the connection gives up. A minute is long enough to read and answer,
+    // and its expiry means "no".
+    timeoutMs: 60_000,
