diff --git a/src/lib/pi/command-policy.ts b/src/lib/pi/command-policy.ts
new file mode 100644
index 0000000..c6ef0f1
--- /dev/null
+++ b/src/lib/pi/command-policy.ts
@@ -0,0 +1,167 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+
+/**
+ * What a shell command is allowed to do before anyone runs it.
+ *
+ * The agent has a shell; a turn reads pages, files and messages from outside,
+ * and a line in any of them could ask for something nobody would agree to if it
+ * were shown. This is the layer that shows it: three answers, decided by the
+ * shape of the command, not by who asked.
+ *
+ * - allow: nothing about it is irreversible and nobody needs to be asked.
+ * - ask: it can destroy work or reach outside the project; the person is asked
+ *   on the card the run already streams, and "no" is the default when nobody
+ *   can answer (a messenger turn, the external API).
+ * - deny: it is destructive in a way that a "yes" would not make safe - wiping
+ *   the workspace or the machine, or reading the credentials the workspace is
+ *   built to keep from it.
+ *
+ * This is a guardrail, not a sandbox: it stops mistakes and borrowed
+ * instructions, and it does not pretend the agent runs as another user.
+ */
+
+export type CommandLevel = "allow" | "ask" | "deny";
+
+export interface CommandVerdict {
+  level: CommandLevel;
+  /** Which rule answered, for the log and the message. */
+  rule?: string;
+  /** One line for the person: what this command would do. */
+  reason?: string;
+}
+
+interface Rule {
+  name: string;
+  level: Exclude<CommandLevel, "allow">;
+  test: RegExp;
+  reason: string;
+}
+
+/**
+ * Rules are matched against the whole command line, with runs of whitespace
+ * collapsed, so `rm   -rf  /` and `rm -rf /` are the same question.
+ */
+const RULES: Rule[] = [
+  // Nothing to ask about: these destroy the workspace or the machine itself.
+  {
+    name: "wipe-root",
+    level: "deny",
+    test: /\brm\s+(?:-[a-z]*\s+)*-?[a-z]*r[a-z]*f[a-z]*\s+(?:\/|\/\*|~|~\/\*|\$HOME|\$HOME\/\*)(?:\s|$)/i,
+    reason: "удаление корня, домашнего каталога или всего сразу",
+  },
+  {
+    name: "wipe-workspace",
+    level: "deny",
+    test: /\brm\s+(?:-[a-z]*\s+)*-?[a-z]*r[a-z]*f[a-z]*\s+(?:\/app(?:\/data)?|\/app\/data\/?)(?:\s|$)/i,
+    reason: "удаление каталога приложения вместе с данными воркспейса",
+  },
+  {
+    name: "destroy-container",
+    level: "deny",
+    test: /\bpct\s+destroy\b|\bqm\s+destroy\b/i,
+    reason: "уничтожение контейнера или виртуальной машины",
+  },
+  {
+    name: "force-push",
+    level: "deny",
+    test: /\bgit\s+push\b[^\n]*(?:--force|--force-with-lease|\s-f(?:\s|$))/i,
+    reason: "перезапись истории в удалённом репозитории",
+  },
+  {
+    name: "write-to-device",
+    level: "deny",
+    test: /\bdd\b[^\n]*\bof=\/dev\/|\bmkfs(?:\.\w+)?\b/i,
+    reason: "запись на устройство или форматирование",
+  },
+  {
+    name: "read-credentials",
+    level: "deny",
+    test: /\b(?:cat|less|more|head|tail|grep|awk|sed|strings|xxd|base64)\b[^\n]*(?:auth\.json|\.env\b|settings\/settings\.json|id_(?:ed25519|rsa|ecdsa)|\.pem\b|secrets\.env)/i,
+    reason: "чтение файла с ключами или токенами",
+  },
+
+  // Destructive or reaching outside the project: ask first.
+  {
+    name: "recursive-delete",
+    level: "ask",
+    test: /\brm\s+(?:-[a-z]*\s+)*-?[a-z]*[rf][a-z]*\s+\S/i,
+    reason: "удаление файлов без корзины",
+  },
+  {
+    name: "sudo",
+    level: "ask",
+    test: /(?:^|[;&|]\s*)sudo\b/i,
+    reason: "команда с правами администратора",
+  },
+  {
+    name: "git-rewrite",
+    level: "ask",
+    test: /\bgit\s+(?:reset\s+--hard|clean\s+-[a-z]*f|checkout\s+--\s+\.|rebase\b|filter-branch\b)/i,
+    reason: "перезапись или потеря локальной истории и незакоммиченных правок",
+  },
+  {
+    name: "container-stop",
+    level: "ask",
+    test: /\b(?:docker|podman)\s+(?:rm|stop|kill|prune)\b|\bsystemctl\s+(?:stop|disable|restart)\b|\bpct\s+(?:stop|shutdown|reboot)\b/i,
+    reason: "остановка или удаление контейнера либо службы",
+  },
+  {
+    name: "pipe-to-shell",
+    level: "ask",
+    test: /\b(?:curl|wget)\b[^\n|]*\|\s*(?:sudo\s+)?(?:ba|z|da)?sh\b/i,
+    reason: "скачать скрипт из интернета и сразу выполнить",
+  },
+  {
+    name: "network-write",
+    level: "ask",
+    test: /\b(?:ssh|scp|rsync)\b[^\n]*\b(?:rm|mv|dd|>\s*\/)/i,
+    reason: "изменение файлов на другой машине",
+  },
+];
+
+/** What this command is: allowed, a question for the person, or refused. */
+export function classifyCommand(command: string): CommandVerdict {
+  const line = command.replace(/\s+/g, " ").trim();
+  if (!line) return { level: "allow" };
+  for (const rule of RULES) {
+    if (rule.test.test(line)) {
+      return { level: rule.level, rule: rule.name, reason: rule.reason };
+    }
+  }
+  return { level: "allow" };
+}
+
+/**
+ * The workspace's own exemptions: whole command lines the person allowed.
+ *
+ * Matched exactly after whitespace is collapsed, never by prefix or pattern: an
+ * exemption that also covers `rm -rf build && rm -rf /` would be a worse problem
+ * than the question it saved.
+ */
+export function isExempt(command: string, allow: readonly string[]): boolean {
+  const line = command.replace(/\s+/g, " ").trim();
+  return allow.some((entry) => entry.replace(/\s+/g, " ").trim() === line);
+}
+
+export interface CommandPolicy {
+  /** Whole command lines the person has allowed for this workspace. */
+  allow: string[];
+}
+
+function policyPath(): string {
+  return path.join(process.cwd(), "data", "policies", "command-policy.json");
+}
+
+/** The exemptions, or none when the file is missing or unreadable. */
+export async function readCommandPolicy(): Promise<CommandPolicy> {
+  try {
+    const raw = JSON.parse(await fs.readFile(policyPath(), "utf-8")) as Partial<CommandPolicy>;
+    const allow = Array.isArray(raw.allow)
+      ? raw.allow.filter((entry): entry is string => typeof entry === "string" && entry.trim().length > 0).slice(0, 500)
+      : [];
+    return { allow };
+  } catch {
+    return { allow: [] };
+  }
+}
