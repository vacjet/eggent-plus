 }
 
+/**
+ * Ask about, or refuse, a command before anything runs.
+ *
+ * Returns the exit code to answer with when the command must not run, and null
+ * when it may. The person is asked on the card the run already streams; a run
+ * with nobody to ask (a messenger, the external API) refuses instead of waiting,
+ * because a turn that stops on an unanswerable question is worse than a command
+ * that did not happen.
+ */
+async function blockedCommand(
+  options: InteractiveBashToolOptions,
+  command: string,
+  onData: (data: Buffer) => void
