+++ b/scripts/test-theme-file.ts
@@ -0,0 +1,36 @@
+/**
+ * Checks what counts as a theme file: a small CSS with variables, and not a page.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-theme-file.ts
+ */
+import assert from "node:assert/strict";
+import { themeProblem } from "../src/lib/themes/current.ts";
+
+let failed = 0;
+let ran = 0;
+function check(name: string, fn: () => void): void {
+  ran += 1;
+  try {
+    fn();
+    console.log(`  ok    ${name}`);
+  } catch (error) {
+    failed += 1;
+    console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+const good = ":root { --background: oklch(1 0 0); }\n.dark { --foreground: oklch(0.2 0 0); }\n";
+
+console.log("что считается темой:\n");
+
+check("обычная тема проходит", () => assert.equal(themeProblem(good), null));
+check("пустой файл — не тема", () => assert.equal(themeProblem("   "), "empty"));
+check("текст без правил — не тема", () => assert.equal(themeProblem("hello"), "not-css"));
+check("страница с script — не тема", () => assert.equal(themeProblem("<script>alert(1)</script>"), "not-css"));
+check("iframe — не тема", () => assert.equal(themeProblem("<iframe src=x></iframe>"), "not-css"));
+check("слишком большой файл — не тема", () => assert.equal(themeProblem(`:root{${"a".repeat(300_000)}}`), "too-large"));
+
+console.log(`\n${ran - failed}/${ran} проверок пройдено`);
+if (failed > 0) process.exit(1);
