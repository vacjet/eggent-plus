index 0000000..6a875a4
--- /dev/null
+++ b/src/app/api/theme.css/route.ts
@@ -0,0 +1,22 @@
+import { currentTheme } from "@/lib/themes/current";
+
+/**
+ * The theme file itself, served to the page that links it.
+ *
+ * A route rather than a static file because the theme lives in `data/`, which is
+ * the person's own directory and outlives the image. No theme is a normal state:
+ * the answer is 404 and the interface keeps its own colours.
+ */
+export async function GET() {
+  const theme = await currentTheme();
+  if (!theme) return new Response("/* no theme */", { status: 404, headers: { "Content-Type": "text/css; charset=utf-8" } });
+  return new Response(theme.css, {
+    headers: {
+      "Content-Type": "text/css; charset=utf-8",
+      // The file can be switched at any time by a copy; a minute of caching is
+      // enough to keep the page from asking on every navigation.
+      "Cache-Control": "public, max-age=60",
+      "X-Content-Type-Options": "nosniff",
+    },
+  });
+}
