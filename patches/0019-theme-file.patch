diff --git a/src/lib/themes/current.ts b/src/lib/themes/current.ts
new file mode 100644
index 0000000..95ac1a5
--- /dev/null
+++ b/src/lib/themes/current.ts
@@ -0,0 +1,40 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+
+/**
+ * The theme in use, as a file the person puts in `data/themes/current.css`.
+ *
+ * There is no theme engine and no marketplace: the interface is styled by CSS
+ * variables, so a theme is a file that overrides a few of them. Keeping it in
+ * `data/` means it survives an image update, and calling it `current.css` means
+ * switching is one copy - which is the whole feature.
+ */
+
+/** Bigger than any theme needs to be; a limit keeps a stray file from being the page. */
+const MAX_THEME_BYTES = 256 * 1024;
+
+export function themeFile(): string {
+  return path.join(process.cwd(), "data", "themes", "current.css");
+}
+
+/** Why this text is not a theme, or null when it is one. Pure, so it can be tested. */
+export function themeProblem(css: string): string | null {
+  if (!css.trim()) return "empty";
+  if (Buffer.byteLength(css, "utf-8") > MAX_THEME_BYTES) return "too-large";
+  if (/<\s*script|<\s*iframe|<\s*style/i.test(css)) return "not-css";
+  if (!css.includes("{")) return "not-css";
+  return null;
+}
+
+/** The theme file, or null when none is set. */
+export async function currentTheme(): Promise<{ css: string; mtimeMs: number } | null> {
+  try {
+    const file = themeFile();
+    const stat = await fs.stat(file);
+    const css = await fs.readFile(file, "utf-8");
+    if (themeProblem(css)) return null;
+    return { css, mtimeMs: stat.mtimeMs };
+  } catch {
+    return null;
+  }
+}
