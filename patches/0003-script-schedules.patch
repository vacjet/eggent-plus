--- /dev/null
+++ b/src/lib/scripts/runner.ts
@@ -0,0 +1,343 @@
+import { spawn } from "node:child_process";
+import fs from "fs/promises";
+import path from "path";
+import {
+  describeSchedule,
+  isDue,
+  parseSchedule,
+  scheduleAfterRun,
+  type ScheduleSpec,
+  type ScriptJob,
+  type ScriptOutcome,
+} from "@/lib/scripts/schedules";
+
+/**
+ * Running a scheduled script, keeping the journal, and the loop that ticks.
+ *
+ * The store is a JSON file a person can open and edit, and the journal is one
+ * JSON object per line: a failure has to be visible a week later without a log
+ * server, and a line per run is the smallest thing that survives `tail`.
+ *
+ * Machine-local bookkeeping lives under data/scripts, next to the other state
+ * that is not shared between computers.
+ */
+
+const MAX_CAPTURED_CHARS = 8000;
+const DEFAULT_TIMEOUT_MS = 10 * 60_000;
+const TICK_MS = 30_000;
+
+export function scriptsDir(): string {
+  return path.join(process.cwd(), "data", "scripts");
+}
+
+export function schedulesPath(): string {
+  return path.join(scriptsDir(), "schedules.json");
+}
+
+export function journalPath(): string {
+  return path.join(scriptsDir(), "runs.jsonl");
+}
+
+interface StoreFile {
+  version: 1;
+  jobs: ScriptJob[];
+}
+
+const running = new Set<string>();
+
+function tail(text: string): string {
+  return text.length > MAX_CAPTURED_CHARS ? `…${text.slice(-MAX_CAPTURED_CHARS)}` : text;
+}
+
+/** Resolve a job's working directory: absolute stays, relative is under data/. */
+export function resolveCwd(cwd?: string): string {
+  if (!cwd) return process.cwd();
+  return path.isAbsolute(cwd) ? cwd : path.join(process.cwd(), cwd);
+}
+
+/**
+ * Run one command and report how it ended.
+ *
+ * `sh -lc` rather than exec of the string: the person writes a command line,
+ * with pipes and `&&`, not an argv. The process group is killed on timeout so a
+ * script that started a child does not leave it behind.
+ */
+export function runCommand(
+  command: string,
+  options: { cwd?: string; timeoutMs?: number; env?: NodeJS.ProcessEnv } = {}
+): Promise<ScriptOutcome> {
+  const startedAt = new Date();
+  const timeoutMs = Math.max(1000, options.timeoutMs ?? DEFAULT_TIMEOUT_MS);
+  return new Promise((resolve) => {
+    const child = spawn("/bin/sh", ["-lc", command], {
+      cwd: resolveCwd(options.cwd),
+      env: { ...process.env, ...options.env },
+      detached: true,
+    });
+
+    let stdout = "";
+    let stderr = "";
+    let timedOut = false;
+    let settled = false;
+
+    const finish = (status: ScriptOutcome["status"], exitCode: number | null) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      const finishedAt = new Date();
+      resolve({
+        status,
+        exitCode,
+        stdout: tail(stdout),
+        stderr: tail(stderr),
+        startedAt: startedAt.toISOString(),
+        finishedAt: finishedAt.toISOString(),
+        durationMs: finishedAt.getTime() - startedAt.getTime(),
+      });
+    };
+
+    const timer = setTimeout(() => {
+      timedOut = true;
+      if (!child.pid) return finish("timeout", null);
+      try {
+        process.kill(-child.pid, "SIGTERM");
+      } catch {
+        child.kill("SIGTERM");
+      }
+      const kill = setTimeout(() => {
+        try {
+          if (child.pid) process.kill(-child.pid, "SIGKILL");
+        } catch {
+          child.kill("SIGKILL");
+        }
+      }, 5000);
+      (kill as { unref?: () => void }).unref?.();
+    }, timeoutMs);
+    (timer as { unref?: () => void }).unref?.();
+
+    child.stdout?.on("data", (chunk: Buffer) => {
+      if (stdout.length < MAX_CAPTURED_CHARS * 2) stdout += chunk.toString();
+    });
+    child.stderr?.on("data", (chunk: Buffer) => {
+      if (stderr.length < MAX_CAPTURED_CHARS * 2) stderr += chunk.toString();
+    });
+    child.on("error", (error) => {
+      stderr += `\n${error.message}`;
+      finish("failed", null);
+    });
+    child.on("close", (code) => {
+      if (timedOut) finish("timeout", code);
+      else finish(code === 0 ? "ok" : "failed", code);
+    });
+  });
+}
+
+async function readStore(): Promise<StoreFile> {
+  try {
+    const parsed = JSON.parse(await fs.readFile(schedulesPath(), "utf-8")) as Partial<StoreFile>;
+    return { version: 1, jobs: Array.isArray(parsed.jobs) ? parsed.jobs : [] };
+  } catch {
+    return { version: 1, jobs: [] };
+  }
+}
+
+async function writeStore(store: StoreFile): Promise<void> {
+  await fs.mkdir(scriptsDir(), { recursive: true });
+  const temp = `${schedulesPath()}.${process.pid}.tmp`;
+  await fs.writeFile(temp, `${JSON.stringify(store, null, 2)}\n`, "utf-8");
+  await fs.rename(temp, schedulesPath());
+}
+
+export async function listScriptJobs(): Promise<ScriptJob[]> {
+  return (await readStore()).jobs;
+}
+
+export interface JournalEntry {
+  jobId: string;
+  name?: string;
+  command: string;
+  status: ScriptOutcome["status"];
+  exitCode: number | null;
+  startedAt: string;
+  finishedAt: string;
+  durationMs: number;
+  stdout: string;
+  stderr: string;
+}
+
+async function appendJournal(entry: JournalEntry): Promise<void> {
+  await fs.mkdir(scriptsDir(), { recursive: true });
+  await fs.appendFile(journalPath(), `${JSON.stringify(entry)}\n`, "utf-8");
+}
+
+export async function readJournal(limit = 20): Promise<JournalEntry[]> {
+  try {
+    const text = await fs.readFile(journalPath(), "utf-8");
+    const lines = text.split("\n").filter((line) => line.trim());
+    const entries: JournalEntry[] = [];
+    for (const line of lines.slice(-Math.max(1, Math.min(200, limit)))) {
+      try {
+        entries.push(JSON.parse(line) as JournalEntry);
+      } catch {
+        // A half-written line (a crash mid-append) is skipped, not fatal.
+      }
+    }
+    return entries.reverse();
+  } catch {
+    return [];
+  }
+}
+
+/** Run one job, record it, and move its next time forward. */
+export async function runScriptJob(jobId: string): Promise<{ job: ScriptJob | null; outcome: ScriptOutcome | null }> {
+  const store = await readStore();
+  const job = store.jobs.find((candidate) => candidate.id === jobId);
+  if (!job) return { job: null, outcome: null };
+  if (running.has(job.id)) return { job, outcome: null };
+
+  running.add(job.id);
+  try {
+    const outcome = await runCommand(job.command, { cwd: job.cwd, timeoutMs: job.timeoutMs });
+    await appendJournal({
+      jobId: job.id,
+      name: job.name,
+      command: job.command,
+      ...outcome,
+    });
+
+    const fresh = await readStore();
+    const target = fresh.jobs.find((candidate) => candidate.id === job.id);
+    if (target) {
+      target.lastRun = outcome.finishedAt;
+      target.lastStatus = outcome.status;
+      target.lastExitCode = outcome.exitCode;
+      target.runCount = (target.runCount ?? 0) + 1;
+      const next = scheduleAfterRun(target, new Date(outcome.finishedAt));
+      target.nextRun = next ?? undefined;
+      if (!next) target.enabled = false; // a one-off has no next time
+      await writeStore(fresh);
+      return { job: target, outcome };
+    }
+    return { job, outcome };
+  } finally {
+    running.delete(job.id);
+  }
+}
+
+/** Every job whose time has come, run one after another. */
+export async function runDueScriptJobs(now = new Date()): Promise<Array<{ jobId: string; status: ScriptOutcome["status"] }>> {
+  const store = await readStore();
+  const due = store.jobs.filter((job) => isDue(job, now));
+  const results: Array<{ jobId: string; status: ScriptOutcome["status"] }> = [];
+  for (const job of due) {
+    const { outcome } = await runScriptJob(job.id);
+    if (outcome) results.push({ jobId: job.id, status: outcome.status });
+  }
+  return results;
+}
+
+function newId(): string {
+  return `script-${Date.now().toString(36)}-${Math.floor(Math.random() * 1e4).toString(36)}`;
+}
+
+export interface AddScriptJobInput {
+  name?: string;
+  command: string;
+  cwd?: string;
+  schedule: string;
+  timeoutMs?: number;
+}
+
+export async function addScriptJob(input: AddScriptJobInput): Promise<{ ok: true; job: ScriptJob } | { ok: false; error: string }> {
+  const command = (input.command || "").trim();
+  if (!command) return { ok: false, error: "a script schedule needs a command" };
+  const parsed = parseSchedule(input.schedule);
+  if (!parsed.ok) return { ok: false, error: parsed.error };
+
+  const now = new Date();
+  const job: ScriptJob = {
+    id: newId(),
+    name: input.name?.trim() || undefined,
+    command,
+    cwd: input.cwd?.trim() || undefined,
+    schedule: parsed.spec as ScheduleSpec,
+    enabled: true,
+    timeoutMs: input.timeoutMs && input.timeoutMs > 0 ? input.timeoutMs : undefined,
+    createdAt: now.toISOString(),
+    nextRun: scheduleAfterRun({ schedule: parsed.spec as ScheduleSpec } as ScriptJob, now) ?? undefined,
+    runCount: 0,
+  };
+  const store = await readStore();
+  store.jobs.push(job);
+  await writeStore(store);
+  return { ok: true, job };
+}
+
+export async function updateScriptJob(
+  id: string,
+  changes: { name?: string; command?: string; cwd?: string; schedule?: string; enabled?: boolean; timeoutMs?: number }
+): Promise<{ ok: true; job: ScriptJob } | { ok: false; error: string }> {
+  const store = await readStore();
+  const job = store.jobs.find((candidate) => candidate.id === id);
+  if (!job) return { ok: false, error: `no script schedule with id ${id}` };
+
+  if (changes.schedule !== undefined) {
+    const parsed = parseSchedule(changes.schedule);
+    if (!parsed.ok) return { ok: false, error: parsed.error };
+    job.schedule = parsed.spec;
+    job.nextRun = scheduleAfterRun(job, new Date()) ?? undefined;
+  }
+  if (changes.command !== undefined) {
+    if (!changes.command.trim()) return { ok: false, error: "the command would be empty" };
+    job.command = changes.command.trim();
+  }
+  if (changes.name !== undefined) job.name = changes.name.trim() || undefined;
+  if (changes.cwd !== undefined) job.cwd = changes.cwd.trim() || undefined;
+  if (changes.timeoutMs !== undefined) job.timeoutMs = changes.timeoutMs > 0 ? changes.timeoutMs : undefined;
+  if (changes.enabled !== undefined) {
+    job.enabled = changes.enabled;
+    if (changes.enabled && !job.nextRun) job.nextRun = scheduleAfterRun(job, new Date()) ?? undefined;
+  }
+  await writeStore(store);
+  return { ok: true, job };
+}
+
+export async function removeScriptJob(id: string): Promise<{ ok: boolean; removed?: ScriptJob }> {
+  const store = await readStore();
+  const index = store.jobs.findIndex((candidate) => candidate.id === id);
+  if (index < 0) return { ok: false };
+  const [removed] = store.jobs.splice(index, 1);
+  await writeStore(store);
+  return { ok: true, removed };
+}
+
+/** What a person sees when they ask what is scheduled. */
+export function describeScriptJob(job: ScriptJob): string {
+  const state = job.enabled ? "on" : "off";
+  const next = job.nextRun ? `next ${job.nextRun}` : "no next run";
+  const last = job.lastRun ? `last ${job.lastStatus ?? "?"} at ${job.lastRun}` : "never ran";
+  return `${job.id} · ${job.name ?? "(no name)"} · ${describeSchedule(job.schedule)} · ${state} · ${last} · ${next} · «${job.command}»`;
+}
+
+let started = false;
+
+/**
+ * Start the loop once per process.
+ *
+ * A tick every half minute is enough for schedules whose smallest unit is a
+ * minute, and it costs nothing when no script is due. `unref` keeps the timer
+ * from holding the process open on shutdown.
+ */
+export function startScriptSchedules(): void {
+  if (started) return;
+  started = true;
+  const tick = () => {
+    runDueScriptJobs().catch((error) => {
+      console.error("Script schedules: a tick failed:", error);
+    });
+  };
+  const initial = setTimeout(tick, 5000);
+  (initial as { unref?: () => void }).unref?.();
+  const timer = setInterval(tick, TICK_MS);
+  (timer as { unref?: () => void }).unref?.();
+}
