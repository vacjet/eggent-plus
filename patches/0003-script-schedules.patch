 import { createPendingInteraction } from "@/lib/pi/pending-interactions";
@@ -1198,6 +1207,108 @@ export async function createEggentPiTools(options: {
         return textResult(JSON.stringify(result, null, 2), result);
       },
     }),
+    defineTool({
+      name: "eggent_script_schedules",
+      label: "Script Schedules",
+      description: [
+        "List, add, change, remove, run or read the journal of scheduled shell commands.",
+        "A script schedule runs its command on its schedule and records the result; no model is involved,",
+        "so it costs no tokens. Use it when the person asks for a recurring check, sync or report that is",
+        "a script rather than a conversation - «every morning run ./check-all.sh».",
+        "Schedules are intervals (5m, 2h, 1d), five-field cron lines, or «at <ISO date>» for one run.",
+      ].join(" "),
+      parameters: Type.Object({
+        action: Type.Union([
+          Type.Literal("list"),
+          Type.Literal("add"),
+          Type.Literal("update"),
+          Type.Literal("remove"),
+          Type.Literal("run"),
+          Type.Literal("journal"),
+        ], { description: "list = what is scheduled; add/update/remove change one job; run starts it now; journal = recent runs." }),
+        id: Type.Optional(Type.String({ description: "Job id for update, remove and run." })),
+        name: Type.Optional(Type.String({ description: "Short name shown in the list." })),
+        command: Type.Optional(Type.String({ description: "Shell command, run through /bin/sh -lc." })),
+        cwd: Type.Optional(Type.String({ description: "Directory to run in; relative paths are under data/." })),
+        schedule: Type.Optional(Type.String({ description: "5m, every 2h, a five-field cron line, or «at 2026-11-14T09:00»." })),
+        enabled: Type.Optional(Type.Boolean({ description: "Switch a job off or back on." })),
+        timeout_ms: Type.Optional(Type.Number({ description: "How long one run may take; defaults to 10 minutes." })),
+        limit: Type.Optional(Type.Number({ description: "How many journal entries to return, newest first. Defaults to 20." })),
+      }),
+      execute: async (_toolCallId, params) => {
+        const action = String(params.action || "list");
+        if (action === "list") {
+          const jobs = await listScriptJobs();
+          return textResult(
+            JSON.stringify({ count: jobs.length, jobs, lines: jobs.map(describeScriptJob) }, null, 2),
+            { count: jobs.length }
+          );
+        }
