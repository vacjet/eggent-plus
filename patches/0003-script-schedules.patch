index 0000000..264c0d0
--- /dev/null
+++ b/scripts/test-script-runner.ts
@@ -0,0 +1,214 @@
+/**
+ * Checks that a script schedule actually runs, records and moves on.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-script-runner.ts
+ *
+ * The tests run real short commands in a temporary data root: the point of this
+ * module is what a shell does, and a mocked shell would prove nothing.
+ */
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import {
+  addScriptJob,
+  describeScriptJob,
+  journalPath,
+  listScriptJobs,
+  readJournal,
+  removeScriptJob,
+  runCommand,
+  runDueScriptJobs,
+  runScriptJob,
+  schedulesPath,
+  updateScriptJob,
+} from "../src/lib/scripts/runner.ts";
+
+let failed = 0;
+let ran = 0;
+async function check(name: string, fn: () => Promise<void> | void): Promise<void> {
+  ran += 1;
+  try {
+    await fn();
+    console.log(`  ok    ${name}`);
+  } catch (error) {
+    failed += 1;
+    console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+const work = await fs.mkdtemp(path.join(os.tmpdir(), "script-schedules-"));
+process.chdir(work);
+await fs.mkdir(path.join(work, "data", "scripts"), { recursive: true });
+
+console.log("running a command:\n");
+
+await check("a command that succeeds reports ok and its output", async () => {
+  const outcome = await runCommand("echo hello && echo world");
+  assert.equal(outcome.status, "ok");
+  assert.equal(outcome.exitCode, 0);
+  assert.match(outcome.stdout, /hello/);
+  assert.match(outcome.stdout, /world/);
+  assert.ok(outcome.durationMs >= 0);
+});
+
+await check("a command that fails reports the exit code", async () => {
+  const outcome = await runCommand("echo boom >&2; exit 3");
+  assert.equal(outcome.status, "failed");
+  assert.equal(outcome.exitCode, 3);
+  assert.match(outcome.stderr, /boom/);
+});
+
+await check("the working directory is the one asked for", async () => {
+  const dir = path.join(work, "somewhere");
+  await fs.mkdir(dir, { recursive: true });
+  const outcome = await runCommand("pwd", { cwd: dir });
+  assert.equal(outcome.stdout.trim(), dir);
+});
+
+await check("a relative working directory is under the data root", async () => {
+  const outcome = await runCommand("pwd", { cwd: "data" });
+  assert.equal(outcome.stdout.trim(), path.join(work, "data"));
+});
+
+await check("a command that hangs is killed and called a timeout", async () => {
+  const started = Date.now();
+  const outcome = await runCommand("sleep 30", { timeoutMs: 1200 });
+  assert.equal(outcome.status, "timeout");
+  assert.ok(Date.now() - started < 10_000, "should not wait for the whole sleep");
+});
+
+await check("a shell syntax error is a failure, not a crash", async () => {
+  const outcome = await runCommand("if then");
+  assert.equal(outcome.status, "failed");
+  assert.notEqual(outcome.exitCode, 0);
+});
+
+console.log("\nkeeping the schedule:\n");
+
+await check("a job is stored with a next run and no tokens spent", async () => {
+  const created = await addScriptJob({ name: "echo", command: "echo job", schedule: "5m" });
+  assert.equal(created.ok, true);
+  if (!created.ok) return;
+  const stored = JSON.parse(await fs.readFile(schedulesPath(), "utf-8"));
+  assert.equal(stored.jobs.length, 1);
+  assert.ok(stored.jobs[0].nextRun, "a next run is computed when the job is added");
+  assert.equal(stored.jobs[0].enabled, true);
+});
+
+await check("a bad schedule is refused and nothing is stored", async () => {
+  const before = (await listScriptJobs()).length;
+  const created = await addScriptJob({ command: "echo x", schedule: "каждое утро" });
+  assert.equal(created.ok, false);
+  assert.equal((await listScriptJobs()).length, before);
+});
+
+await check("a command is required", async () => {
+  const created = await addScriptJob({ command: "   ", schedule: "5m" });
+  assert.equal(created.ok, false);
+});
+
+await check("running a job records the run and moves the next time", async () => {
+  const created = await addScriptJob({ name: "run me", command: "echo run-ok", schedule: "5m" });
+  assert.equal(created.ok, true);
+  if (!created.ok) return;
+
+  const { outcome } = await runScriptJob(created.job.id);
+  assert.equal(outcome?.status, "ok");
+  const job = (await listScriptJobs()).find((candidate) => candidate.id === created.job.id)!;
+  assert.equal(job.lastStatus, "ok");
+  assert.equal(job.runCount, 1);
+  assert.ok(job.nextRun && new Date(job.nextRun).getTime() > new Date(job.lastRun!).getTime());
+
+  const journal = await readJournal(5);
+  assert.ok(journal.some((entry) => entry.jobId === created.job.id && entry.stdout.includes("run-ok")));
+});
+
+await check("the journal is one line per run and readable newest first", async () => {
+  const second = await addScriptJob({ name: "second", command: "echo second", schedule: "5m" });
+  assert.equal(second.ok, true);
+  if (second.ok) await runScriptJob(second.job.id);
+  const raw = await fs.readFile(journalPath(), "utf-8");
+  const lines = raw.trim().split("\n");
+  assert.ok(lines.length >= 2);
+  for (const line of lines) JSON.parse(line);
+  const journal = await readJournal(2);
+  assert.equal(journal.length, 2);
+  assert.ok(new Date(journal[0].startedAt).getTime() >= new Date(journal[1].startedAt).getTime());
+});
+
+await check("only due jobs run, and a switched-off one never does", async () => {
+  const created = await addScriptJob({ name: "future", command: "echo future", schedule: "1d" });
+  assert.equal(created.ok, true);
+  if (!created.ok) return;
+  await updateScriptJob(created.job.id, { enabled: false });
+
+  const due = await runDueScriptJobs(new Date());
+  assert.equal(due.length, 0);
+
+  await updateScriptJob(created.job.id, { enabled: true });
+  const store = JSON.parse(await fs.readFile(schedulesPath(), "utf-8"));
+  const target = store.jobs.find((job: { id: string }) => job.id === created.job.id);
+  target.nextRun = new Date(Date.now() - 60_000).toISOString();
+  await fs.writeFile(schedulesPath(), JSON.stringify(store), "utf-8");
+
+  const dueNow = await runDueScriptJobs(new Date());
+  assert.equal(dueNow.length, 1);
+  assert.equal(dueNow[0].status, "ok");
+});
+
+await check("a one-off switches itself off after it ran", async () => {
+  const created = await addScriptJob({ name: "once", command: "echo once", schedule: `at ${new Date(Date.now() - 60_000).toISOString()}` });
+  assert.equal(created.ok, true);
+  if (!created.ok) return;
+  const { outcome } = await runScriptJob(created.job.id);
+  assert.equal(outcome?.status, "ok");
+  const updated = (await listScriptJobs()).find((job) => job.id === created.job.id);
+  assert.equal(updated?.enabled, false, "a one-off has no next time, so it is off");
+  assert.equal(updated?.nextRun, undefined);
+});
+
+await check("updating a schedule recomputes the next run", async () => {
+  const created = await addScriptJob({ name: "retime", command: "echo x", schedule: "1d" });
+  assert.equal(created.ok, true);
+  if (!created.ok) return;
+  const updated = await updateScriptJob(created.job.id, { schedule: "*/15 * * * *" });
+  assert.equal(updated.ok, true);
+  if (updated.ok) assert.equal(updated.job.schedule.type, "cron");
+  const bad = await updateScriptJob(created.job.id, { schedule: "nonsense" });
+  assert.equal(bad.ok, false);
+});
+
+await check("a job can be removed, and removing a stranger does nothing", async () => {
+  const created = await addScriptJob({ name: "bye", command: "echo bye", schedule: "5m" });
+  assert.equal(created.ok, true);
+  if (!created.ok) return;
+  assert.equal((await removeScriptJob(created.job.id)).ok, true);
+  assert.equal((await removeScriptJob("no-such-id")).ok, false);
+  assert.equal((await listScriptJobs()).some((job) => job.id === created.job.id), false);
+});
+
+await check("a job line says what is scheduled and what happened", async () => {
+  const created = await addScriptJob({ name: "line", command: "echo line", schedule: "2h" });
+  assert.equal(created.ok, true);
+  if (!created.ok) return;
+  await runScriptJob(created.job.id);
+  const line = describeScriptJob((await listScriptJobs()).find((job) => job.id === created.job.id)!);
+  assert.match(line, /every 2h/);
+  assert.match(line, /on/);
+  assert.match(line, /last ok/);
+  assert.match(line, /echo line/);
+});
+
+await check("a broken journal line does not hide the rest", async () => {
+  await fs.appendFile(journalPath(), '{"jobId":"half",', "utf-8");
+  const entries = await readJournal(10);
+  assert.ok(entries.length >= 2, "the good lines are still readable");
+});
+
+await fs.rm(work, { recursive: true, force: true });
+
+console.log(`\n${ran} checks, ${failed} failed`);
+process.exit(failed > 0 ? 1 : 0);
diff --git a/scripts/test-script-schedules.ts b/scripts/test-script-schedules.ts
new file mode 100644
index 0000000..62ccd9a
--- /dev/null
+++ b/scripts/test-script-schedules.ts
@@ -0,0 +1,211 @@
+/**
+ * Checks the meaning of a script schedule: what a person's line parses into,
+ * when it fires, and when it is due.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-script-schedules.ts
+ *
+ * Every date here is fixed: a test that depends on today would pass and fail on
+ * its own, and this logic decides whether somebody's nightly job runs at one in
+ * the morning or not at all.
+ */
+import assert from "node:assert/strict";
+import {
+  cronMatches,
+  describeSchedule,
+  isDue,
+  nextRunAfter,
+  parseCron,
+  parseInterval,
+  parseSchedule,
+  scheduleAfterRun,
+  type ScriptJob,
+} from "../src/lib/scripts/schedules.ts";
+
+let failed = 0;
+let ran = 0;
+function check(name: string, fn: () => void): void {
+  ran += 1;
+  try {
+    fn();
+    console.log(`  ok    ${name}`);
+  } catch (error) {
+    failed += 1;
+    console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+/** Local-time date, the way cron is read. */
+function at(text: string): Date {
+  return new Date(text);
+}
+
+function job(overrides: Partial<ScriptJob>): ScriptJob {
+  return {
+    id: "j1",
+    command: "echo hi",
+    schedule: { type: "interval", everyMs: 300_000 },
+    enabled: true,
+    createdAt: "2026-11-13T09:00:00.000Z",
+    ...overrides,
+  };
+}
+
+console.log("intervals:\n");
+
+check("5m, every 2h, 30s, 1d are durations", () => {
+  assert.equal(parseInterval("5m"), 300_000);
+  assert.equal(parseInterval("every 2h"), 7_200_000);
+  assert.equal(parseInterval("30s"), 30_000);
+  assert.equal(parseInterval("1d"), 86_400_000);
+});
+
+check("nonsense is not a duration", () => {
+  for (const text of ["0m", "abc", "5x", "", "every", "-5m", "5 m 3"]) {
+    assert.equal(parseInterval(text), null, `«${text}» should not parse`);
+  }
+});
+
+console.log("\ncron parsing:\n");
+
+check("common cron lines parse", () => {
+  for (const expression of ["*/15 * * * *", "0 9 * * 1-5", "0 0 1 * *", "30 6,18 * * *", "5 4 * * 0"]) {
+    assert.ok(parseCron(expression), `«${expression}» should parse`);
+  }
+});
+
+check("out-of-range and malformed cron lines do not", () => {
+  for (const expression of [
+    "* * * *",
+    "60 * * * *",
+    "* 24 * * *",
+    "*/0 * * * *",
+    "5-1 * * * *",
+    "* * 0 * *",
+    "* * * 13 *",
+    "* * * * 8",
+    "a * * * *",
+  ]) {
+    assert.equal(parseCron(expression), null, `«${expression}» should not parse`);
+  }
+});
+
+check("seven is Sunday too", () => {
+  assert.ok(cronMatches("0 9 * * 7", at("2026-11-15T09:00:00"))); // воскресенье
+});
+
+console.log("\nfiring:\n");
+
+check("a fixed time matches only that minute", () => {
+  assert.equal(cronMatches("0 9 * * *", at("2026-11-13T09:00:00")), true);
+  assert.equal(cronMatches("0 9 * * *", at("2026-11-13T09:01:00")), false);
+  assert.equal(cronMatches("0 9 * * *", at("2026-11-13T21:00:00")), false);
+});
+
+check("weekdays exclude the weekend", () => {
+  const friday = at("2026-11-13T09:00:00");
+  const saturday = at("2026-11-14T09:00:00");
+  assert.equal(cronMatches("0 9 * * 1-5", friday), true);
+  assert.equal(cronMatches("0 9 * * 1-5", saturday), false);
+  assert.equal(cronMatches("0 9 * * 1-5", saturday), false);
+});
+
+check("day of month and day of week are an «or», as cron has it", () => {
+  // 1 ноября 2026 — воскресенье, 2 ноября — понедельник.
+  assert.equal(cronMatches("0 0 1 * 1", at("2026-11-01T00:00:00")), true, "the 1st");
+  assert.equal(cronMatches("0 0 1 * 1", at("2026-11-02T00:00:00")), true, "a Monday");
+  assert.equal(cronMatches("0 0 1 * 1", at("2026-11-03T00:00:00")), false, "neither");
+});
+
+check("steps fire on the step", () => {
+  for (const minute of [0, 15, 30, 45]) {
+    assert.equal(cronMatches("*/15 * * * *", at(`2026-11-13T10:${String(minute).padStart(2, "0")}:00`)), true);
+  }
+  assert.equal(cronMatches("*/15 * * * *", at("2026-11-13T10:07:00")), false);
+});
+
+console.log("\nnext run:\n");
+
+check("an interval counts from now", () => {
+  const from = at("2026-11-13T09:00:00");
+  const next = nextRunAfter({ type: "interval", everyMs: 300_000 }, from);
+  assert.equal(next?.toISOString(), at("2026-11-13T09:05:00").toISOString());
+});
+
+check("the next minute wins over the current one", () => {
+  const next = nextRunAfter({ type: "cron", expression: "0 9 * * *" }, at("2026-11-13T09:00:00"));
+  assert.equal(next?.toISOString().slice(0, 16), "2026-11-14T09:00");
+});
+
+check("midnight is found across the date line", () => {
+  const next = nextRunAfter({ type: "cron", expression: "0 0 * * *" }, at("2026-11-13T23:59:00"));
+  assert.equal(next?.toISOString().slice(0, 16), "2026-11-14T00:00");
+});
+
+check("a yearly schedule is found within the year", () => {
+  const next = nextRunAfter({ type: "cron", expression: "0 0 1 1 *" }, at("2026-11-13T12:00:00"));
+  assert.equal(next?.toISOString().slice(0, 10), "2027-01-01");
+});
+
+check("a one-off in the past never fires again", () => {
+  assert.equal(nextRunAfter({ type: "once", at: "2026-11-01T09:00:00" }, at("2026-11-13T09:00:00")), null);
+  assert.ok(nextRunAfter({ type: "once", at: "2026-12-01T09:00:00" }, at("2026-11-13T09:00:00")));
+});
+
+console.log("\nwhat a person types:\n");
+
+check("«5m», a cron line and «at …» all parse", () => {
+  assert.deepEqual(parseSchedule("5m"), { ok: true, spec: { type: "interval", everyMs: 300_000 } });
+  assert.deepEqual(parseSchedule("*/15 * * * *"), { ok: true, spec: { type: "cron", expression: "*/15 * * * *" } });
+  const once = parseSchedule("at 2026-11-14T09:00");
+  assert.equal(once.ok, true);
+  if (once.ok) assert.equal(once.spec.type, "once");
+});
+
+check("too fast and nonsense are refused with a reason", () => {
+  const fast = parseSchedule("30s");
+  assert.equal(fast.ok, false);
+  if (!fast.ok) assert.match(fast.error, /one minute/);
+
+  const nonsense = parseSchedule("каждое утро");
+  assert.equal(nonsense.ok, false);
+  if (!nonsense.ok) assert.match(nonsense.error, /interval|cron/);
+
+  assert.equal(parseSchedule("").ok, false);
+  assert.equal(parseSchedule("at not-a-date").ok, false);
+});
+
+check("a schedule is described the way it was asked for", () => {
+  assert.equal(describeSchedule({ type: "interval", everyMs: 7_200_000 }), "every 2h");
+  assert.equal(describeSchedule({ type: "cron", expression: "0 9 * * *" }), "0 9 * * *");
+  assert.equal(describeSchedule({ type: "once", at: "2026-11-14T09:00:00.000Z" }), "once at 2026-11-14T09:00:00.000Z");
+});
+
+console.log("\ndue:\n");
+
+check("a job whose time has come is due, a switched-off one never is", () => {
+  const now = at("2026-11-13T10:00:00");
+  assert.equal(isDue(job({ nextRun: "2026-11-13T09:59:00.000Z" }), now), true);
+  assert.equal(isDue(job({ nextRun: "2026-11-13T09:59:00.000Z", enabled: false }), now), false);
+  assert.equal(isDue(job({ nextRun: "2026-11-13T10:01:00.000Z" }), now), false);
+});
+
+check("a one-off that already ran is not due again", () => {
+  const now = at("2026-11-13T10:00:00");
+  const once = job({
+    schedule: { type: "once", at: "2026-11-13T09:00:00.000Z" },
+    nextRun: "2026-11-13T09:00:00.000Z",
+    lastRun: "2026-11-13T09:00:01.000Z",
+  });
+  assert.equal(isDue(once, now), false);
+});
+
+check("after a run the next time is computed, and a one-off has none", () => {
+  const next = scheduleAfterRun(job({ schedule: { type: "cron", expression: "0 9 * * *" } }), at("2026-11-13T09:00:05"));
+  assert.equal(next?.slice(0, 16), "2026-11-14T09:00");
+  assert.equal(scheduleAfterRun(job({ schedule: { type: "once", at: "2026-11-13T09:00:00.000Z" } }), at("2026-11-13T09:00:05")), null);
+});
+
+console.log(`\n${ran} checks, ${failed} failed`);
+process.exit(failed > 0 ? 1 : 0);
