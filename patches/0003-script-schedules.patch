@@ -0,0 +1,233 @@
+/**
+ * Script schedules: a task that runs a shell command with no model behind it.
+ *
+ * A scheduled job in `pi-subagents` is a prompt, and a prompt is a turn: it
+ * costs tokens even when all it does is run `check-all.sh` and say whether it
+ * passed. The person who asked for "every morning, run this script" wants the
+ * script, not a conversation about it.
+ *
+ * This module is the logic only: what a schedule means, when it is due, and
+ * what to do with the answer. Running, storing and showing live in
+ * `script-runner.ts`; keeping the parsing pure is what makes it testable
+ * without a clock or a shell.
+ */
+
+export type ScheduleSpec =
+  | { type: "interval"; everyMs: number }
+  | { type: "cron"; expression: string }
+  | { type: "once"; at: string };
+
+export interface ScriptOutcome {
+  status: "ok" | "failed" | "timeout";
+  exitCode: number | null;
+  stdout: string;
+  stderr: string;
+  startedAt: string;
+  finishedAt: string;
+  durationMs: number;
+}
+
+export interface ScriptJob {
+  id: string;
+  name?: string;
+  /** Shell command, run through `/bin/sh -lc`. */
+  command: string;
+  /** Directory to run in; relative paths are resolved against the projects root. */
+  cwd?: string;
+  schedule: ScheduleSpec;
+  enabled: boolean;
+  /** How long one run may take. Defaults to 10 minutes. */
+  timeoutMs?: number;
+  createdAt: string;
+  lastRun?: string;
+  lastStatus?: ScriptOutcome["status"];
+  lastExitCode?: number | null;
+  nextRun?: string;
+  runCount?: number;
+}
+
+const INTERVAL_UNITS: Record<string, number> = {
+  s: 1000,
+  m: 60_000,
+  h: 3_600_000,
+  d: 86_400_000,
+};
+
+const MAX_CRON_SCAN_MINUTES = 366 * 24 * 60;
+
+/** "5m", "every 2h", "30s", "1d" — a duration people actually type. */
+export function parseInterval(text: string): number | null {
+  const match = /^\s*(?:every\s+)?(\d+)\s*(s|m|h|d)\s*$/i.exec(text);
+  if (!match) return null;
+  const amount = Number(match[1]);
+  if (!Number.isFinite(amount) || amount <= 0) return null;
+  return amount * INTERVAL_UNITS[match[2].toLowerCase()];
+}
+
+function parseField(text: string, min: number, max: number, allowSeven = false): Set<number> | null {
+  const values = new Set<number>();
+  for (const part of text.split(",")) {
+    const piece = part.trim();
+    if (!piece) return null;
+    const stepMatch = /^(.+?)\/(\d+)$/.exec(piece);
+    const step = stepMatch ? Number(stepMatch[2]) : 1;
+    if (!Number.isFinite(step) || step <= 0) return null;
+    const body = stepMatch ? stepMatch[1] : piece;
+
+    let from: number;
+    let to: number;
+    if (body === "*") {
+      from = min;
+      to = max;
+    } else if (/^\d+$/.test(body)) {
+      from = Number(body);
+      to = stepMatch ? max : from;
+    } else {
+      const range = /^(\d+)-(\d+)$/.exec(body);
+      if (!range) return null;
+      from = Number(range[1]);
+      to = Number(range[2]);
+    }
+    if (from > to) return null;
+    for (let value = from; value <= to; value += step) {
+      if (value < min || value > max) {
+        if (allowSeven && value === 7) {
+          values.add(0);
+          continue;
+        }
+        return null;
+      }
+      values.add(value);
+    }
+  }
+  return values.size > 0 ? values : null;
+}
+
+interface CronSpec {
+  minutes: Set<number>;
+  hours: Set<number>;
+  days: Set<number>;
+  months: Set<number>;
+  weekdays: Set<number>;
+  /** Cron's "or" between day-of-month and day-of-week when both are restricted. */
+  dayRestricted: boolean;
+  weekdayRestricted: boolean;
+}
+
+export function parseCron(expression: string): CronSpec | null {
+  const fields = expression.trim().split(/\s+/);
+  if (fields.length !== 5) return null;
+  const minutes = parseField(fields[0], 0, 59);
+  const hours = parseField(fields[1], 0, 23);
+  const days = parseField(fields[2], 1, 31);
+  const months = parseField(fields[3], 1, 12);
+  const weekdays = parseField(fields[4], 0, 6, true);
+  if (!minutes || !hours || !days || !months || !weekdays) return null;
+  return {
+    minutes,
+    hours,
+    days,
+    months,
+    weekdays,
+    dayRestricted: fields[2].trim() !== "*",
+    weekdayRestricted: fields[4].trim() !== "*",
+  };
+}
+
+/** Whether the cron expression fires in this exact minute (seconds are ignored). */
+export function cronMatches(expression: string, when: Date): boolean {
+  const spec = parseCron(expression);
+  if (!spec) return false;
+  if (!spec.minutes.has(when.getMinutes())) return false;
+  if (!spec.hours.has(when.getHours())) return false;
+  if (!spec.months.has(when.getMonth() + 1)) return false;
+  const dayMatches = spec.days.has(when.getDate());
+  const weekdayMatches = spec.weekdays.has(when.getDay());
+  if (spec.dayRestricted && spec.weekdayRestricted) return dayMatches || weekdayMatches;
+  if (spec.dayRestricted) return dayMatches;
+  if (spec.weekdayRestricted) return weekdayMatches;
+  return true;
+}
+
+/**
+ * The first firing strictly after `from`, or null when there is none.
+ *
+ * Cron is scanned minute by minute: a year of minutes is cheap next to the cost
+ * of getting "next Monday at 9" wrong by an off-by-one nobody notices for a week.
+ */
+export function nextRunAfter(spec: ScheduleSpec, from: Date): Date | null {
+  if (spec.type === "interval") return new Date(from.getTime() + spec.everyMs);
+  if (spec.type === "once") {
+    const at = new Date(spec.at);
+    if (Number.isNaN(at.getTime())) return null;
+    return at.getTime() > from.getTime() ? at : null;
+  }
+  if (!parseCron(spec.expression)) return null;
+  const cursor = new Date(from.getTime());
+  cursor.setSeconds(0, 0);
+  cursor.setMinutes(cursor.getMinutes() + 1);
+  for (let step = 0; step < MAX_CRON_SCAN_MINUTES; step += 1) {
+    if (cronMatches(spec.expression, cursor)) return new Date(cursor.getTime());
+    cursor.setMinutes(cursor.getMinutes() + 1);
+  }
+  return null;
+}
+
+/** A person's schedule line turned into a spec, or a message saying why not. */
+export function parseSchedule(text: string): { ok: true; spec: ScheduleSpec } | { ok: false; error: string } {
+  const trimmed = (text || "").trim();
+  if (!trimmed) return { ok: false, error: "schedule is empty" };
+
+  if (/^at\s+/i.test(trimmed)) {
+    const at = new Date(trimmed.replace(/^at\s+/i, ""));
+    if (Number.isNaN(at.getTime())) return { ok: false, error: "the date after «at» is not a date" };
+    return { ok: true, spec: { type: "once", at: at.toISOString() } };
+  }
+
+  const everyMs = parseInterval(trimmed);
+  if (everyMs !== null) {
+    if (everyMs < 60_000) return { ok: false, error: "the shortest interval is one minute" };
+    return { ok: true, spec: { type: "interval", everyMs } };
+  }
+
+  if (parseCron(trimmed)) return { ok: true, spec: { type: "cron", expression: trimmed } };
+
+  return {
+    ok: false,
+    error: "not a schedule: use an interval (5m, every 2h), a five-field cron line, or «at 2026-11-14T09:00»",
+  };
+}
+
+export function describeSchedule(spec: ScheduleSpec): string {
+  if (spec.type === "interval") {
+    // Крупная единица первой: 7200000 мс — это «every 2h», а не «every 7200s».
+    for (const unit of ["d", "h", "m", "s"]) {
+      const size = INTERVAL_UNITS[unit];
+      if (spec.everyMs % size === 0) return `every ${spec.everyMs / size}${unit}`;
+    }
+    return `every ${spec.everyMs} ms`;
+  }
+  if (spec.type === "once") return `once at ${spec.at}`;
+  return spec.expression;
+}
+
+/** Whether the job should run now, ignoring the ones already running. */
+export function isDue(job: ScriptJob, now: Date): boolean {
+  if (!job.enabled) return false;
+  if (job.schedule.type === "once" && job.lastRun) return false;
+  const due = job.nextRun ? new Date(job.nextRun) : nextRunAfter(job.schedule, new Date(job.createdAt));
+  if (!due || Number.isNaN(due.getTime())) return false;
+  return due.getTime() <= now.getTime();
+}
+
+export function scheduleAfterRun(job: ScriptJob, finished: Date): string | null {
+  const next = nextRunAfter(job.schedule, finished);
+  return next ? next.toISOString() : null;
+}
+
+/** One line for a person: what ran, how it ended, how long it took. */
+export function describeOutcome(outcome: ScriptOutcome): string {
+  const seconds = (outcome.durationMs / 1000).toFixed(1);
+  const code = outcome.exitCode === null ? "no exit code" : `code ${outcome.exitCode}`;
+  return `${outcome.status} (${code}, ${seconds}s)`;
+}
