index c266c3f..1a7d192 100644
--- a/src/app/dashboard/settings/general/page.tsx
+++ b/src/app/dashboard/settings/general/page.tsx
@@ -244,6 +244,46 @@ export default function GeneralSettingsPage() {
           </section>
         </>
       )}
+      <BuildVersion />
     </SettingsShell>
   );
 }
+
+/**
+ * Which build answers here.
+ *
+ * Read from `/api/build-info`, which the deployment writes next to the instance's
+ * data: a plain image has no such file, and then the line is simply absent
+ * rather than claiming a version nobody verified.
+ */
+function BuildVersion() {
+  const { t, locale } = useI18n();
+  const [info, setInfo] = useState<{ version: string | null; builtAt?: string } | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    fetch("/api/build-info", { cache: "no-store" })
+      .then((response) => (response.ok ? response.json() : null))
+      .then((body) => {
+        if (!cancelled && body && typeof body.version === "string") {
+          setInfo({ version: body.version, builtAt: typeof body.builtAt === "string" ? body.builtAt : undefined });
+        }
+      })
+      .catch(() => {});
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  if (!info?.version) return null;
+  const built = info.builtAt ? new Date(info.builtAt) : null;
+  const date = built && !Number.isNaN(built.getTime())
+    ? new Intl.DateTimeFormat(locale === "ru" ? "ru-RU" : "en-US", { dateStyle: "medium", timeStyle: "short" }).format(built)
+    : "";
+  return (
+    <p className="text-xs text-muted-foreground">
+      {t("settings.build", { version: info.version })}
+      {date ? ` · ${date}` : ""}
+    </p>
+  );
+}
