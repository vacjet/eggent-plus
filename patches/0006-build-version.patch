diff --git a/src/lib/build-info.ts b/src/lib/build-info.ts
new file mode 100644
index 0000000..8324df0
--- /dev/null
+++ b/src/lib/build-info.ts
@@ -0,0 +1,59 @@
+import fs from "fs/promises";
+import path from "path";
+
+/**
+ * Which build is answering: upstream version, how many of our patches are in
+ * it, and the commit they came from.
+ *
+ * `0.8.0+plus.5.98a76b6` reads as "Eggent 0.8.0, five patches, built from that
+ * commit". A number that only counts builds (`0.8.0.1321`) tells nobody whether
+ * the patch they are waiting for is in it; the patch count does, and the commit
+ * says exactly which state of the repository produced the image.
+ *
+ * The file is written by the deployment (docker/deploy-test.sh), not at build
+ * time inside the app: the same image can be deployed twice, and what a person
+ * needs to know is what is running now.
+ */
+
+export interface BuildInfo {
+  /** Upstream tag the image was built from, e.g. "v0.8.0". */
+  upstream: string;
+  /** How many patches from `patches/` were applied. */
+  patches: number;
+  /** Commit of the eggent-plus repository the patches came from. */
+  commit?: string;
+  /** When the image was built, ISO. */
+  builtAt?: string;
+  /** What the settings page shows, e.g. "0.8.0+plus.5.98a76b6". */
+  version: string;
+}
+
+export function formatBuildVersion(upstream: string, patches: number, commit?: string): string {
+  const base = (upstream || "").replace(/^v/i, "").trim() || "0.0.0";
+  const count = Number.isFinite(patches) ? Math.max(0, Math.trunc(patches)) : 0;
+  const short = (commit || "").trim().slice(0, 7);
+  return `${base}+plus.${count}${short ? `.${short}` : ""}`;
+}
+
+function buildInfoPath(): string {
+  return path.join(process.cwd(), "data", "build-info.json");
+}
+
+/** The build that is running, or null when nobody wrote it (a plain image). */
+export async function readBuildInfo(): Promise<BuildInfo | null> {
+  try {
+    const raw = JSON.parse(await fs.readFile(buildInfoPath(), "utf-8")) as Partial<BuildInfo>;
+    const upstream = typeof raw.upstream === "string" ? raw.upstream : "";
+    const patches = Number(raw.patches);
+    if (!upstream || !Number.isFinite(patches)) return null;
+    return {
+      upstream,
+      patches,
+      commit: typeof raw.commit === "string" ? raw.commit : undefined,
+      builtAt: typeof raw.builtAt === "string" ? raw.builtAt : undefined,
+      version: formatBuildVersion(upstream, patches, typeof raw.commit === "string" ? raw.commit : undefined),
+    };
+  } catch {
+    return null;
+  }
+}
