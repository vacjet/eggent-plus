+import { NextResponse } from "next/server";
+import { readBuildInfo } from "@/lib/build-info";
+
+/** Which build answers here; null when the image was not deployed with the file. */
+export async function GET() {
+  const info = await readBuildInfo();
+  return NextResponse.json(info ?? { version: null });
+}
