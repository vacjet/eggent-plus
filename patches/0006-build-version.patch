index 0000000..63bb724
--- /dev/null
+++ b/scripts/test-build-info.ts
@@ -0,0 +1,81 @@
+/**
+ * Checks the build line: how a version reads, and what happens when nobody
+ * wrote a build file.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-build-info.ts
+ */
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { formatBuildVersion, readBuildInfo } from "../src/lib/build-info.ts";
+
+let failed = 0;
+let ran = 0;
+async function check(name: string, fn: () => Promise<void> | void): Promise<void> {
+  ran += 1;
+  try {
+    await fn();
+    console.log(`  ok    ${name}`);
+  } catch (error) {
+    failed += 1;
+    console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+console.log("version text:\n");
+
+await check("tag, patch count and commit make a readable version", () => {
+  assert.equal(formatBuildVersion("v0.8.0", 5, "98a76b6c1d2e"), "0.8.0+plus.5.98a76b6");
+});
+
+await check("a version without a commit is still a version", () => {
+  assert.equal(formatBuildVersion("v0.8.0", 3), "0.8.0+plus.3");
+});
+
+await check("nonsense collapses to something short instead of «v+plus.NaN»", () => {
+  assert.equal(formatBuildVersion("", Number.NaN), "0.0.0+plus.0");
+  assert.equal(formatBuildVersion("v", -2), "0.0.0+plus.0");
+});
+
+console.log("\nreading the file:\n");
+
+const work = await fs.mkdtemp(path.join(os.tmpdir(), "build-info-"));
+const dataDir = path.join(work, "data");
+await fs.mkdir(dataDir, { recursive: true });
+const cwd = process.cwd();
+
+await check("no file means no build line, not a wrong one", async () => {
+  process.chdir(work);
+  const info = await readBuildInfo();
+  assert.equal(info, null);
+  process.chdir(cwd);
+});
+
+await check("a written file is read back with a computed version", async () => {
+  await fs.writeFile(
+    path.join(dataDir, "build-info.json"),
+    JSON.stringify({ upstream: "v0.8.0", patches: 6, commit: "abc1234def", builtAt: "2026-11-13T21:00:00.000Z" })
+  );
+  process.chdir(work);
+  const info = await readBuildInfo();
+  process.chdir(cwd);
+  assert.equal(info?.version, "0.8.0+plus.6.abc1234");
+  assert.equal(info?.patches, 6);
+  assert.equal(info?.builtAt, "2026-11-13T21:00:00.000Z");
+});
+
+await check("a half-written file is ignored rather than shown", async () => {
+  await fs.writeFile(path.join(dataDir, "build-info.json"), JSON.stringify({ upstream: "v0.8.0" }));
+  process.chdir(work);
+  const info = await readBuildInfo();
+  process.chdir(cwd);
+  assert.equal(info, null, "no patch count, no claim");
+});
+
+await fs.rm(work, { recursive: true, force: true });
+
+console.log(`\n${ran} checks, ${failed} failed`);
+process.exit(failed > 0 ? 1 : 0);
