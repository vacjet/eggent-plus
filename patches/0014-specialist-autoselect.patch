@@ -0,0 +1,97 @@
+"use client";
+
+/**
+ * Which specialist this chat is with, and the menu that changes it.
+ *
+ * It sits in the chat's header, beside the name of the screen: the specialist is
+ * a property of the conversation, and the first thing worth seeing when a chat
+ * is opened again weeks later. Switching is one click - the same click that
+ * opens the menu - because a specialist is a lens, not a setting: it is changed
+ * mid-thought and changed back.
+ */
+
+import { Check, ChevronDown, Loader2, UserRound } from "lucide-react";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
+import { useI18n } from "@/i18n/provider";
+import type { ChatSpecialist } from "@/lib/types";
+import type { SpecialistOption } from "@/lib/specialists/choice";
+
+export interface SpecialistBadgeProps {
+  /** The specialist this chat is with; absent when it has none. */
+  current: ChatSpecialist | null;
+  /** What this project could be with. An empty list hides the badge entirely. */
+  options: SpecialistOption[];
+  /** `null` takes the specialist away. */
+  onPick: (id: string | null) => void;
+  /** A switch is being saved: the menu shows it and cannot start another. */
+  busy?: boolean;
+}
+
+export function SpecialistBadge({ current, options, onPick, busy }: SpecialistBadgeProps) {
+  const { t } = useI18n();
+
+  if (options.length === 0) return null;
+
+  return (
+    <Popover>
+      <PopoverTrigger asChild>
+        <button
+          type="button"
+          data-testid="chat-specialist"
+          title={current ? t("chat.specialist.hint", { title: current.title }) : t("chat.specialist.noneHint")}
+          className="inline-flex max-w-[14rem] shrink-0 items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:outline-none"
+        >
+          {busy ? (
+            <Loader2 className="size-3.5 shrink-0 animate-spin" aria-hidden />
+          ) : (
+            <UserRound className="size-3.5 shrink-0" aria-hidden />
+          )}
+          <span className="truncate">
+            {current ? current.title : t("chat.specialist.none")}
+          </span>
+          <ChevronDown className="size-3 shrink-0 opacity-60" aria-hidden />
+        </button>
+      </PopoverTrigger>
+      <PopoverContent align="start" className="w-72 p-1">
+        <p className="px-2 py-1.5 text-xs text-muted-foreground">{t("chat.specialist.choose")}</p>
+        <ul className="max-h-72 overflow-y-auto">
+          {options.map((option) => {
+            const selected = current?.id === option.id;
+            return (
+              <li key={option.id}>
+                <button
+                  type="button"
+                  disabled={busy}
+                  onClick={() => {
+                    if (!selected) onPick(option.id);
+                  }}
+                  className="flex w-full items-start gap-2 rounded-md px-2 py-1.5 text-left transition-colors hover:bg-accent disabled:opacity-50"
+                >
+                  <Check
+                    className={`mt-0.5 size-3.5 shrink-0 ${selected ? "opacity-100" : "opacity-0"}`}
+                    aria-hidden
+                  />
+                  <span className="min-w-0">
+                    <span className="block truncate text-sm">{option.title}</span>
+                    <span className="block truncate text-xs text-muted-foreground">{option.summary}</span>
+                  </span>
+                </button>
+              </li>
+            );
+          })}
+        </ul>
+        {current ? (
+          <button
+            type="button"
+            disabled={busy}
+            onClick={() => onPick(null)}
+            className="mt-1 flex w-full items-center gap-2 rounded-md border-t px-2 py-1.5 text-left text-xs text-muted-foreground transition-colors hover:bg-accent disabled:opacity-50"
+          >
