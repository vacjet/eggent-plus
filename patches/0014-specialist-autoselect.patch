@@ -0,0 +1,69 @@
+import { NextRequest, NextResponse } from "next/server";
+import { getChat, setChatSpecialist } from "@/lib/storage/chat-store";
+import { listProjectSpecialists } from "@/lib/specialists/catalog";
+import { specialistForDisplay } from "@/lib/specialists/choice";
+import type { ChatSpecialist } from "@/lib/types";
+
+export const runtime = "nodejs";
+
+/**
+ * The specialist a chat is with, and the ones this project could be with.
+ *
+ * GET reads both in one round trip: a badge needs the current one and the menu
+ * needs the rest, and asking twice per screen would be two reads of the same
+ * project for one answer. PUT is the "switch with one click": the person picks
+ * an id from the catalogue, or `null` to take the specialist away.
+ */
+export async function GET(
+  _req: NextRequest,
+  { params }: { params: Promise<{ chatId: string }> }
+) {
+  const { chatId } = await params;
+  const chat = await getChat(chatId);
+  if (!chat) {
+    return NextResponse.json({ error: "Chat not found" }, { status: 404 });
+  }
+  const options = chat.projectId ? await listProjectSpecialists(chat.projectId) : [];
+  return NextResponse.json({
+    current: specialistForDisplay(chat.specialist, options),
+    options,
+  });
+}
+
+export async function PUT(
+  req: NextRequest,
+  { params }: { params: Promise<{ chatId: string }> }
+) {
+  const { chatId } = await params;
+  const chat = await getChat(chatId);
+  if (!chat) {
+    return NextResponse.json({ error: "Chat not found" }, { status: 404 });
+  }
+
+  let body: unknown;
+  try {
+    body = await req.json();
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body" }, { status: 400 });
+  }
+  const record = typeof body === "object" && body !== null ? (body as Record<string, unknown>) : {};
+  const wanted = typeof record.id === "string" ? record.id.trim() : "";
+
+  if (!wanted) {
+    await setChatSpecialist(chatId, null);
+    return NextResponse.json({ current: null, options: chat.projectId ? await listProjectSpecialists(chat.projectId) : [] });
+  }
+
+  if (!chat.projectId) {
+    return NextResponse.json({ error: "This chat has no project to take a specialist from" }, { status: 400 });
+  }
+  const options = await listProjectSpecialists(chat.projectId);
+  const picked = options.find((option) => option.id === wanted);
+  if (!picked) {
+    return NextResponse.json({ error: "No such specialist installed in this project" }, { status: 400 });
+  }
+
+  const specialist: ChatSpecialist = { id: picked.id, title: picked.title, by: "person" };
+  await setChatSpecialist(chatId, specialist);
+  return NextResponse.json({ current: specialistForDisplay(specialist, options), options });
+}
