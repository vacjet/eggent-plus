@@ -0,0 +1,58 @@
+"use client";
+
+/**
+ * The specialist badge, carried from the chat to the header it belongs in.
+ *
+ * The header is part of the dashboard shell: it is rendered by the layout, not
+ * by the chat, and the chat is the only thing that knows which specialist the
+ * conversation is with. So the chat publishes here and the header reads - one
+ * small context rather than a second copy of the chat's state in the layout, and
+ * nothing at all on a screen that is not a chat.
+ */
+
+import { createContext, useCallback, useContext, useMemo, useState, type ReactNode } from "react";
+import { SpecialistBadge } from "@/components/chat/specialist-badge";
+import type { ChatSpecialist } from "@/lib/types";
+import type { SpecialistOption } from "@/lib/specialists/choice";
+
+export interface ChatSpecialistView {
+  current: ChatSpecialist | null;
+  options: SpecialistOption[];
+  onPick: (id: string | null) => void;
+  busy: boolean;
+}
+
+interface ChatSpecialistContextValue {
+  view: ChatSpecialistView | null;
+  publish: (view: ChatSpecialistView | null) => void;
+}
+
+const ChatSpecialistContext = createContext<ChatSpecialistContextValue | null>(null);
+
+export function ChatSpecialistProvider({ children }: { children: ReactNode }) {
+  const [view, setView] = useState<ChatSpecialistView | null>(null);
+  const publish = useCallback((next: ChatSpecialistView | null) => setView(next), []);
+  const value = useMemo(() => ({ view, publish }), [view, publish]);
+  return <ChatSpecialistContext.Provider value={value}>{children}</ChatSpecialistContext.Provider>;
+}
+
+/** For the chat: publish what it knows, and take it back when it unmounts. */
+export function useChatSpecialistPublisher(): (view: ChatSpecialistView | null) => void {
+  const context = useContext(ChatSpecialistContext);
+  return context?.publish ?? (() => undefined);
+}
+
+/** For the header: the badge, or nothing on a screen without a chat. */
+export function ChatSpecialistSlot() {
+  const context = useContext(ChatSpecialistContext);
+  const view = context?.view;
+  if (!view) return null;
+  return (
+    <SpecialistBadge
+      current={view.current}
+      options={view.options}
+      onPick={view.onPick}
+      busy={view.busy}
+    />
+  );
+}
