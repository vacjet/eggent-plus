+++ b/scripts/test-specialist-choice.ts
@@ -0,0 +1,158 @@
+/**
+ * Checks the rules that pick a chat's specialist: when the question is asked,
+ * what it says, what counts as an answer, and what the turn is told.
+ *
+ * Run with Node 22:
+ *   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \
+ *     --import ./scripts/alias-loader-register.mjs scripts/test-specialist-choice.ts
+ *
+ * The one thing not tested here is the model call itself: it needs a provider.
+ * Its answer is a string, and that string is what these rules are tested on.
+ */
+import assert from "node:assert/strict";
+import {
+  parseSpecialistChoice,
+  selectionPrompt,
+  shouldChooseSpecialist,
+  specialistForDisplay,
+  specialistPromptNote,
+  type SpecialistOption,
+} from "../src/lib/specialists/choice.ts";
+
+let failed = 0;
+let ran = 0;
+function check(name: string, fn: () => void): void {
+  ran += 1;
+  try {
+    fn();
+    console.log(`  ok    ${name}`);
+  } catch (error) {
+    failed += 1;
+    console.log(`  FAIL  ${name}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+const seo: SpecialistOption = { id: "seo", title: "SEO", summary: "индексация и трафик" };
+const direct: SpecialistOption = {
+  id: "yandex-direct",
+  title: "Контекстная реклама",
+  summary: "расход и кампании",
+};
+const lawyer: SpecialistOption = { id: "legal", title: "Юрист", summary: "риски договора" };
+const catalogue = [seo, direct, lawyer];
+
+console.log("разбор ответа модели:\n");
+
+check("id как есть", () => {
+  assert.equal(parseSpecialistChoice("seo", catalogue), "seo");
+});
+
+check("id в кавычках и с точкой", () => {
+  assert.equal(parseSpecialistChoice('  "legal".  ', catalogue), "legal");
+});
+
+check("id заглавными", () => {
+  assert.equal(parseSpecialistChoice("SEO", catalogue), "seo");
+});
+
+check("«none» — специалиста нет", () => {
+  assert.equal(parseSpecialistChoice("none", catalogue), null);
+});
+
+check("пустой ответ — специалиста нет", () => {
+  assert.equal(parseSpecialistChoice("   ", catalogue), null);
+});
+
+check("id внутри фразы", () => {
+  assert.equal(parseSpecialistChoice("This is legal work.", catalogue), "legal");
+});
+
+check("длинный id побеждает короткий", () => {
+  const both = [
+    { id: "direct", title: "Директ", summary: "" },
+    { id: "yandex-direct", title: "Яндекс.Директ", summary: "" },
+  ];
+  assert.equal(parseSpecialistChoice("yandex-direct", both), "yandex-direct");
+});
+
+check("выдуманный id не принимается", () => {
+  assert.equal(parseSpecialistChoice("маркетинг", catalogue), null);
+});
+
+check("чужой id не принимается", () => {
+  assert.equal(parseSpecialistChoice("content", catalogue), null);
+});
+
+console.log("\nкогда спрашивать:\n");
+
+check("первый ход нового чата — спрашиваем", () => {
+  assert.equal(
+    shouldChooseSpecialist({ hasSpecialist: false, messageCount: 0, candidateCount: 3 }),
+    true
+  );
+});
+
+check("в чате уже есть ответ — не спрашиваем", () => {
+  assert.equal(
+    shouldChooseSpecialist({ hasSpecialist: false, messageCount: 2, candidateCount: 3 }),
+    false
+  );
+});
+
+check("специалист уже выбран — не переспрашиваем", () => {
+  assert.equal(
+    shouldChooseSpecialist({ hasSpecialist: true, messageCount: 0, candidateCount: 3 }),
+    false
+  );
+});
+
+check("в проекте нет специалистов — не спрашиваем", () => {
+  assert.equal(
+    shouldChooseSpecialist({ hasSpecialist: false, messageCount: 0, candidateCount: 0 }),
+    false
+  );
+});
+
+console.log("\nпромпт выбора:\n");
+
+check("перечисляет id, название и назначение", () => {
+  const prompt = selectionPrompt("проверь сайт", catalogue);
+  for (const candidate of catalogue) {
+    assert.ok(prompt.includes(candidate.id), `нет id ${candidate.id}`);
+    assert.ok(prompt.includes(candidate.title), `нет названия ${candidate.title}`);
+  }
+  assert.ok(prompt.includes("проверь сайт"));
+});
+
+check("длинное сообщение обрезается", () => {
+  const prompt = selectionPrompt("x".repeat(5000), catalogue);
+  assert.ok(prompt.length < 2500, `промпт слишком длинный: ${prompt.length}`);
+});
+
+console.log("\nзаметка ходу:\n");
+
+check("называет скилл путём, который агент может открыть", () => {
+  const note = specialistPromptNote(seo);
+  assert.ok(note.includes("skills/seo/SKILL.md"), note);
+  assert.ok(note.includes("SEO"), note);
+});
+
+console.log("\nподпись для экрана:\n");
+
+check("название из каталога важнее сохранённого", () => {
+  const display = specialistForDisplay({ id: "seo", title: "Старое имя", by: "auto" }, catalogue);
+  assert.equal(display?.title, "SEO");
+});
+
+check("без пакета — сохранённое название", () => {
+  const display = specialistForDisplay({ id: "gone", title: "Бывший", by: "person" }, catalogue);
+  assert.equal(display?.title, "Бывший");
+  assert.equal(display?.by, "person");
+});
+
+check("без специалиста — ничего", () => {
+  assert.equal(specialistForDisplay(null, catalogue), null);
+});
+
+console.log(`\n${ran - failed}/${ran} проверок пройдено`);
+if (failed > 0) process.exit(1);
