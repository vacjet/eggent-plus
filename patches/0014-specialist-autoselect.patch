diff --git a/src/lib/specialists/assign.ts b/src/lib/specialists/assign.ts
new file mode 100644
index 0000000..17ed766
--- /dev/null
+++ b/src/lib/specialists/assign.ts
@@ -0,0 +1,51 @@
+import { getChat, setChatSpecialist } from "@/lib/storage/chat-store";
+import { listProjectSpecialists } from "@/lib/specialists/catalog";
+import { chooseSpecialist } from "@/lib/specialists/select";
+import { shouldChooseSpecialist, type ChatSpecialist } from "@/lib/specialists/choice";
+
+/**
+ * Give a chat its specialist on the first message, once.
+ *
+ * Called on the way in to a turn, before the answer starts: the badge is then
+ * there while the answer is written, not after it. Every reason not to decide -
+ * a chat that already has an answer, a project with no specialists, a model that
+ * is unavailable or slow - ends with the turn running exactly as it would have
+ * without this, which is why nothing here throws.
+ */
+export async function autoAssignSpecialist(params: {
+  chatId: string;
+  projectId?: string | null;
+  message: string;
+  timeoutMs?: number;
+}): Promise<ChatSpecialist | null> {
+  if (!params.projectId) return null;
+  try {
+    const chat = await getChat(params.chatId);
+    if (!chat) return null;
+
+    const candidates = await listProjectSpecialists(params.projectId);
+    if (
+      !shouldChooseSpecialist({
+        hasSpecialist: Boolean(chat.specialist),
+        messageCount: chat.messages.length,
+        candidateCount: candidates.length,
+      })
+    ) {
+      return null;
+    }
+
+    const picked = await chooseSpecialist({
+      projectId: params.projectId,
+      message: params.message,
+      candidates,
+      ...(params.timeoutMs !== undefined ? { timeoutMs: params.timeoutMs } : {}),
+    });
+    if (!picked) return null;
+
+    const specialist: ChatSpecialist = { id: picked.id, title: picked.title, by: "auto" };
+    await setChatSpecialist(params.chatId, specialist);
+    return specialist;
+  } catch {
+    return null;
+  }
+}
diff --git a/src/lib/specialists/catalog.ts b/src/lib/specialists/catalog.ts
new file mode 100644
index 0000000..9978eda
--- /dev/null
+++ b/src/lib/specialists/catalog.ts
@@ -0,0 +1,68 @@
+import fs from "fs/promises";
+import path from "path";
+import { loadProjectSkillsMetadata } from "@/lib/storage/project-store";
+import type { SpecialistOption } from "@/lib/specialists/choice";
+
+/** The file that makes a skill a specialist; the runtime copies it with the skill. */
+export const SPECIALIST_FILE = "specialist.json";
+
+/**
+ * The specialists installed in a project.
+ *
+ * A specialist is a skill - installed from the catalogue into
+ * `data/projects/<id>/skills/<name>/` - that also carries `specialist.json`.
+ * The file is the whole difference: the runtime copies the package as it is and
+ * ignores the extra file, so nothing here is another registry to keep in step.
+ */
+export async function listProjectSpecialists(projectId: string): Promise<SpecialistOption[]> {
+  const skills = await loadProjectSkillsMetadata(projectId);
+  const found: SpecialistOption[] = [];
+
+  for (const skill of skills) {
+    const option = await readSpecialist(skill.skillDir, skill.name, skill.description);
+    if (option) found.push(option);
+  }
+
+  return found.sort((left, right) => left.title.localeCompare(right.title, "ru"));
+}
+
+/**
+ * One package, read as a specialist. A package whose id is not its folder is not
+ * one: the runtime loads skills by folder name, and a catalogue entry that
+ * answers to another name would never be the skill that runs.
+ */
+async function readSpecialist(
+  skillDir: string,
+  folderName: string,
+  skillDescription: string
+): Promise<SpecialistOption | null> {
+  let raw: string;
+  try {
+    raw = await fs.readFile(path.join(skillDir, SPECIALIST_FILE), "utf-8");
+  } catch {
+    return null;
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    return null;
+  }
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return null;
+
+  const record = parsed as Record<string, unknown>;
+  const id = typeof record.id === "string" ? record.id.trim().toLowerCase() : "";
+  if (!id || id !== folderName.toLowerCase()) return null;
+
+  const title =
+    typeof record.title === "string" && record.title.trim()
+      ? record.title.trim()
+      : folderName;
+  const summary =
+    typeof record.summary === "string" && record.summary.trim()
+      ? record.summary.trim()
+      : skillDescription;
+
+  return { id: folderName, title, summary };
+}
diff --git a/src/lib/specialists/choice.ts b/src/lib/specialists/choice.ts
new file mode 100644
index 0000000..404b5f3
--- /dev/null
+++ b/src/lib/specialists/choice.ts
@@ -0,0 +1,127 @@
+/**
+ * Which specialist answers in a chat: the rules, and the words around the one
+ * small model call that picks one.
+ *
+ * Everything here is pure - no disk, no network, no runtime - so the rules can
+ * be tested on their own. The caller reads the catalogue from the project's
+ * skills, asks a model with the prompt built here, and hands the answer back to
+ * `parseSpecialistChoice`.
+ */
+
+export interface SpecialistOption {
+  /** The skill's name, which is also the folder it was installed into. */
+  id: string;
+  /** How the catalogue names it, in the person's language. */
+  title: string;
+  /** One line: what this specialist is for. */
+  summary: string;
+}
+
+/** Where a chat's specialist came from: chosen by the model or by the person. */
+export type SpecialistSource = "auto" | "person";
+
+/** The specialist a chat is with, as it is stored on the chat. */
+export interface ChatSpecialist {
+  id: string;
+  title: string;
+  by: SpecialistSource;
+}
+
+export const SPECIALIST_SYSTEM_PROMPT = [
+  "You choose which specialist should answer a person's first message.",
+  "You are given the specialists installed in this project and the message.",
+  "Answer with exactly one specialist id from the list, and nothing else.",
+  "If no specialist fits, answer exactly: none",
+].join("\n");
+
+/**
+ * The one user message the chooser sees: the list, then the request.
+ *
+ * The message is cut: the first few hundred characters say what the work is,
+ * and a long pasted document would only make the call expensive.
+ */
+export function selectionPrompt(message: string, candidates: SpecialistOption[]): string {
+  const list = candidates
+    .map((candidate) => `- ${candidate.id}: ${candidate.title} - ${candidate.summary}`)
+    .join("\n");
+  const said = message.replace(/\s+/g, " ").trim().slice(0, 1200);
+  return `Specialists installed in this project:\n${list}\n\nFirst message:\n${said}\n\nAnswer with one id from the list, or none.`;
+}
+
+/**
+ * The id the model named, or nothing.
+ *
+ * A model that is told to answer with one id mostly does; the rest of this is
+ * tolerance for the ways they fail - quotes, a trailing sentence, the id inside
+ * a sentence - without letting a guess through: an id that is not in the
+ * catalogue is not a choice.
+ */
+export function parseSpecialistChoice(answer: string, candidates: SpecialistOption[]): string | null {
+  const text = answer.trim().replace(/^["'`]+|["'`.]+$/g, "").trim();
+  if (!text) return null;
+  const lowered = text.toLowerCase();
+  if (lowered === "none" || lowered === "-" || lowered === "нет") return null;
+
+  const byId = candidates.find((candidate) => candidate.id.toLowerCase() === lowered);
+  if (byId) return byId.id;
+
+  // The longest id that appears as a whole word wins, so "direct" does not
+  // answer for "yandex-direct".
+  const named = candidates
+    .filter((candidate) => new RegExp(`(^|[^a-z0-9_-])${escapeRegExp(candidate.id.toLowerCase())}([^a-z0-9_-]|$)`).test(lowered))
+    .sort((a, b) => b.id.length - a.id.length)[0];
+  return named?.id ?? null;
+}
+
+/**
+ * Whether this turn is the moment to choose.
+ *
+ * Once per chat, on the first message, and only when there is something to
+ * choose between: a chat that already has an answer, or a project with no
+ * specialists installed, has nothing for a model to decide.
+ */
+export function shouldChooseSpecialist(params: {
+  hasSpecialist: boolean;
+  /** Messages already in the chat, before this turn. */
+  messageCount: number;
+  candidateCount: number;
+}): boolean {
+  return !params.hasSpecialist && params.messageCount === 0 && params.candidateCount > 0;
+}
+
+/**
+ * What the turn is told about its specialist.
+ *
+ * The skill itself is installed in the project and the runtime lists it; this
+ * line is what makes the choice hold for the turn - a skill the model may open
+ * and a chat that is with this specialist are different things.
+ */
+export function specialistPromptNote(option: Pick<SpecialistOption, "id" | "title">): string {
+  return [
+    `This chat is with the specialist "${option.title}" (skill "${option.id}").`,
+    `Read skills/${option.id}/SKILL.md before answering and follow it.`,
+    "If the request is outside what this specialist does, say so in one line and then answer as usual.",
+  ].join(" ");
+}
+
+/**
+ * The title to show for a stored specialist, preferring the catalogue's current
+ * one: a package renamed between turns keeps the id and changes the label.
+ */
+export function specialistForDisplay(
+  stored: { id: string; title?: string; by?: SpecialistSource } | null | undefined,
+  candidates: SpecialistOption[]
+): ChatSpecialist | null {
+  if (!stored) return null;
+  const current = candidates.find((candidate) => candidate.id === stored.id);
+  const title = current?.title || stored.title || stored.id;
+  return {
+    id: stored.id,
+    title,
+    by: stored.by === "person" ? "person" : "auto",
+  };
+}
+
+function escapeRegExp(value: string): string {
+  return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
diff --git a/src/lib/specialists/select.ts b/src/lib/specialists/select.ts
new file mode 100644
index 0000000..4b3008e
--- /dev/null
+++ b/src/lib/specialists/select.ts
@@ -0,0 +1,182 @@
+import "@/lib/pi/env";
+import {
+  createAgentSession,
+  DefaultResourceLoader,
+  SessionManager,
+} from "@earendil-works/pi-coding-agent";
+import {
+  fallbackRuntimeModel,
+  getPiAgentDir,
+  getPiModelRegistry,
+  getPiModelRuntime,
+  getResolvedPiRuntimeModel,
+} from "@/lib/pi/config-store";
+import { getWorkDir } from "@/lib/storage/project-store";
+import { getSettings } from "@/lib/storage/settings-store";
+import {
+  parseSpecialistChoice,
+  selectionPrompt,
+  SPECIALIST_SYSTEM_PROMPT,
+  type SpecialistOption,
+} from "@/lib/specialists/choice";
+
+/** A model the runtime can serve right now. */
+type AvailableModel = ReturnType<Awaited<ReturnType<typeof getPiModelRegistry>>["getAvailable"]>[number];
+
+/**
+ * The one small call that picks a chat's specialist.
+ *
+ * It is a turn with no tools: a system line saying "answer with one id" and the
+ * person's first message, which is all a classifier needs. Nothing of the chat
+ * itself is loaded - no history, no MCP, no project files - so the cost is a few
+ * hundred tokens and cannot pull the workspace into the prompt.
+ *
+ * The model is the workspace's utility model when it is one the runtime can
+ * serve, and the chat's own model otherwise: `utilityModel` is a setting with a
+ * default of `openai/gpt-4o-mini`, and a workspace that never configured one
+ * must still get a choice rather than a silent nothing.
+ */
+
+export interface SpecialistCallInput {
+  system: string;
+  prompt: string;
+  signal?: AbortSignal;
+}
+
+/** One question answered by a model. Injectable so the rules can be tested without one. */
+export type SpecialistCompleter = (input: SpecialistCallInput) => Promise<string>;
+
+export interface ChooseSpecialistParams {
+  projectId?: string | null;
+  message: string;
+  candidates: SpecialistOption[];
+  /** How long the turn is willing to wait for the answer. */
+  timeoutMs?: number;
+  complete?: SpecialistCompleter;
+}
+
+/**
+ * The specialist this message belongs to, or nothing.
+ *
+ * Nothing is a normal answer: no specialist fits, the model is unavailable, the
+ * call ran long. None of those may hold up the turn that the person is waiting
+ * for, so every failure here ends the same way and quietly.
+ */
+export async function chooseSpecialist(params: ChooseSpecialistParams): Promise<SpecialistOption | null> {
+  const { candidates } = params;
+  if (candidates.length === 0) return null;
+  // One installed specialist is not a choice, and asking a model to confirm it
+  // would be a call per chat for an answer that is already known.
+  if (candidates.length === 1) return candidates[0];
+
+  const complete = params.complete ?? piCompleter(params.projectId);
+  const timeoutMs = params.timeoutMs ?? 10_000;
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+
+  try {
+    const answer = await complete({
+      system: SPECIALIST_SYSTEM_PROMPT,
+      prompt: selectionPrompt(params.message, candidates),
+      signal: controller.signal,
+    });
+    const id = parseSpecialistChoice(answer, candidates);
+    return candidates.find((candidate) => candidate.id === id) ?? null;
+  } catch {
+    return null;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/**
+ * One question, answered by the runtime's model, in a session that can do
+ * nothing else.
+ */
+function piCompleter(projectId?: string | null): SpecialistCompleter {
+  return async (input) => {
+    const picked = await resolveModel(projectId);
+    if (!picked) throw new Error("no model is available for the specialist choice");
+
+    const cwd = getWorkDir(projectId ?? undefined);
+    const agentDir = getPiAgentDir();
+    const resourceLoader = new DefaultResourceLoader({
+      cwd,
+      agentDir,
+      noExtensions: true,
+      noSkills: true,
+      noPromptTemplates: true,
+      noThemes: true,
+      systemPromptOverride: () => input.system,
+      agentsFilesOverride: () => ({ agentsFiles: [] }),
+    });
+    await resourceLoader.reload();
+
+    const { session } = await createAgentSession({
+      cwd,
+      agentDir,
+      model: picked.model,
+      modelRuntime: picked.runtime,
+      thinkingLevel: "off",
+      // Nothing to call: the answer is one word, and a tool loop would be a
+      // second way for this to cost money or write something.
+      noTools: "all",
+      resourceLoader,
+      sessionManager: SessionManager.inMemory(cwd),
+    });
+
+    const abort = () => {
+      void session.abort().catch(() => undefined);
+    };
+    if (input.signal?.aborted) abort();
+    else input.signal?.addEventListener("abort", abort, { once: true });
+
+    try {
+      await session.prompt(input.prompt);
+      return session.getLastAssistantText() ?? "";
+    } finally {
+      input.signal?.removeEventListener("abort", abort);
+      session.dispose();
+    }
+  };
+}
+
+/**
+ * Which model answers the choice.
+ *
+ * The utility model when the runtime has that exact provider and model with a
+ * credential; otherwise the model the chat itself will run on, so a workspace
+ * that never touched `utilityModel` is not left without a choice. A project
+ * running on a program of this computer is skipped: there are no tokens there
+ * and nothing to spend them on.
+ */
+async function resolveModel(projectId?: string | null): Promise<{ model: AvailableModel; runtime: Awaited<ReturnType<typeof getPiModelRuntime>> } | null> {
+  const runtime = await getPiModelRuntime();
+  const registry = await getPiModelRegistry(runtime);
+  await registry.refresh();
+  const available = registry.getAvailable();
+  if (available.length === 0) return null;
+
+  const settings = await getSettings();
+  const utility = settings.utilityModel;
+  if (utility) {
+    const served = available.find(
+      (model) => model.provider === utility.provider && model.id === utility.model
+    );
+    if (served) return { model: served, runtime };
+  }
+
+  try {
+    const chatModel = await getResolvedPiRuntimeModel(projectId);
+    if (chatModel.engine) return null;
+    const same = available.find(
+      (model) => model.provider === chatModel.model?.provider && model.id === chatModel.model?.id
+    );
+    if (same) return { model: same, runtime };
+  } catch {
+    // No model resolved for the chat: the fallback below is the last word.
+  }
+
+  const fallback = await fallbackRuntimeModel(available);
+  return fallback ? { model: fallback, runtime } : null;
+}
